# Docker / Production environment variables
# Copy to .env and fill in values before running docker-compose

# Frontend: API URL (used at build time, must be accessible from user's browser)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Backend: base URL for generating absolute URLs in responses (emails, file links)
API_BASE_URL=http://localhost:3001

# JWT (required for auth)
JWT_SECRET=your-secret-key-min-32-chars
JWT_EXPIRES_IN=7d
