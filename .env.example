# # =============================================================================
# # Platform TIR — переменные окружения
# # =============================================================================
# # Скопируйте в .env и заполните значения перед запуском:
# #   cp .env.example .env
# # =============================================================================

# # -----------------------------------------------------------------------------
# # Домен (обязательно для production)
# # -----------------------------------------------------------------------------
# # Публичный URL сайта (без слэша в конце), например https://example.com
# SITE_URL=https://example.com

# # -----------------------------------------------------------------------------
# # Frontend (build-time)
# # -----------------------------------------------------------------------------
# # URL API: для cookie refresh — тот же origin что и сайт (nginx/Next проксирует /api/v1)
# NEXT_PUBLIC_API_URL=/api/v1
# # Тот же публичный origin, что SITE_URL — вшивается при сборке фронта (metadataBase / Open Graph)
# NEXT_PUBLIC_SITE_URL=https://example.com
# # URL бэкенда внутри Docker-сети (для Next.js rewrites)
# API_INTERNAL_URL=http://backend:3001

# # -----------------------------------------------------------------------------
# # Backend
# # -----------------------------------------------------------------------------
# # CORS: через запятую все домены (кириллические — в Punycode: node -e "console.log(require('url').domainToASCII('домен.рф'))")
# CORS_ORIGIN=https://example.com
# # URL бэкенда для ссылок. Для загрузок (/uploads/) суффикс /api/v1 автоматически убирается.
# # Можно указать https://example.com или https://example.com/api/v1 — оба варианта работают.
# API_BASE_URL=https://example.com/api/v1
# # JWT (обязательно! сгенерируйте свой ключ: openssl rand -hex 32)
# JWT_SECRET=your-secret-key-min-32-chars-change-in-production
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=30d
# REFRESH_COOKIE_NAME=rt
# REFRESH_COOKIE_SECURE=true
# # REFRESH_COOKIE_DOMAIN=.example.com

# # -----------------------------------------------------------------------------
# # База данных (production)
# # -----------------------------------------------------------------------------
# # Формат: postgresql://USER:PASSWORD@postgres:5432/DATABASE?schema=public
# # В docker-compose.prod.yml postgres настраивается через POSTGRES_* переменные
# POSTGRES_USER=platform_user
# POSTGRES_PASSWORD=change-this-strong-password
# POSTGRES_DB=platform_tir
# DATABASE_URL=postgresql://platform_user:change-this-strong-password@postgres:5432/platform_tir?schema=public

# # -----------------------------------------------------------------------------
# # Yandex ID OAuth (вход через Яндекс)
# # -----------------------------------------------------------------------------
# # YANDEX_CLIENT_ID=<ClientID из панели приложения>
# # YANDEX_CLIENT_SECRET=<Client secret>
# # Redirect URI в настройках приложения: https://your-domain.com/auth/yandex/callback

# # -----------------------------------------------------------------------------
# # Email (восстановление пароля, письма заказов)
# # -----------------------------------------------------------------------------
# # MAIL_FROM=noreply@example.com
# # SMTP_HOST=smtp.example.com
# # SMTP_PORT=587
# # SMTP_USER=
# # SMTP_PASS=

# # -----------------------------------------------------------------------------
# # Telegram (уведомления о заявках с форм)
# # -----------------------------------------------------------------------------
# # Токен бота от @BotFather. При наличии — заявки дублируются в Telegram.
# # TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# # -----------------------------------------------------------------------------
# # Web Push (push-уведомления админки в установленном PWA на телефоне)
# # -----------------------------------------------------------------------------
# # Сгенерировать: cd backend && node -e "const w=require('web-push'); const k=w.generateVAPIDKeys(); console.log(k)"
# # VAPID_PUBLIC_KEY=
# # VAPID_PRIVATE_KEY=
# # VAPID_SUBJECT=mailto:admin@example.com

# # -----------------------------------------------------------------------------
# # Квиз-лендинги (отдельные домены)
# # -----------------------------------------------------------------------------
# # Домены квизов через запятую (без https). Middleware Next.js перенаправляет на /quiz
# # QUIZ_DOMAINS=mebel-na-zakaz-51.ru,remont-kvartir-51.ru
# NEXT_PUBLIC_QUIZ_DOMAINS=mebel-na-zakaz-51.ru,remont-kvartir-51.ru
# # Добавьте домены квизов в CORS_ORIGIN, например:
# # CORS_ORIGIN=https://territory-interior.ru,https://mebel-na-zakaz-51.ru,https://remont-kvartir-51.ru

# # -----------------------------------------------------------------------------
# # Elasticsearch (опционально для production)
# # -----------------------------------------------------------------------------
# # По умолчанию используется встроенный в docker-compose
# # ELASTICSEARCH_NODE=http://elasticsearch:9200


# =============================================================================
# Platform TIR — production для territory-interior.ru и территория-интерьерных-решений.рф
# =============================================================================
# Скопируйте в .env и заполните JWT_SECRET, POSTGRES_PASSWORD:
#   cp .env.production.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Домен (основной)
# -----------------------------------------------------------------------------
SITE_URL=https://territory-interior.ru

# -----------------------------------------------------------------------------
# Frontend (build-time)
# -----------------------------------------------------------------------------
# Относительный путь — работает с обоими доменами (без CORS)
NEXT_PUBLIC_API_URL=/api/v1
API_INTERNAL_URL=http://backend:3001

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
# Оба домена: латиница + Punycode для кириллического
CORS_ORIGIN=https://territory-interior.ru,https://xn-----mlcbabasabfm9bcdf6aacfbc3aeg7f4dwdza7f.xn--p1ai
API_BASE_URL=https://territory-interior.ru/api/v1
JWT_SECRET=ОБЯЗАТЕЛЬНО_ЗАМЕНИТЕ_openssl_rand_hex_32
# JWT_EXPIRES_IN=7d
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# httpOnly refresh: в prod Secure=true (по умолчанию от NODE_ENV); для поддоменов задайте Domain
REFRESH_COOKIE_NAME=rt
REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_DOMAIN=.territory-interior.ru

# -----------------------------------------------------------------------------
# База данных
# -----------------------------------------------------------------------------
POSTGRES_USER=platform_user
POSTGRES_PASSWORD=ОБЯЗАТЕЛЬНО_ЗАМЕНИТЕ
POSTGRES_DB=platform_tir
DATABASE_URL=postgresql://platform_user:ОБЯЗАТЕЛЬНО_ЗАМЕНИТЕ@postgres:5432/platform_tir?schema=public

#
# Владелец образов в GHCR

GHCR_IMAGE_PREFIX=ghcr.io/Ruslan-Skv