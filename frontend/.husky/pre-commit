#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🚀 Running frontend pre-commit checks..."

# 1. Запуск lint-staged для форматирования только staged файлов
echo "🔍 Running lint-staged on staged files..."
npx lint-staged || {
  echo "❌ Lint-staged checks failed"
  exit 1
}

# 2. Проверка типов TypeScript (tsc --noEmit)
echo "🔍 Type checking (tsc --noEmit)..."
npm run type-check || {
  echo "❌ TypeScript errors found"
  exit 1
}

# 3. Проверка ESLint
echo "🔍 Linting (ESLint)..."
npm run lint || {
  echo "❌ ESLint errors found"
  exit 1
}

# 4. Проверка архитектуры frontend
echo "🔍 Checking frontend architecture..."
npm run check-architecture || {
  echo "❌ Architecture violations found (see frontend/docs/ARCHITECTURE.md)"
  exit 1
}

echo "✅ All frontend pre-commit checks passed!"

