# =============================================================================
# Platform TIR — production
# Основной: territory-interior.ru
# Зеркала (301→основной): территория-интерьерных-решений.рф, 601270.ru
# =============================================================================
# Скопируйте в .env и заполните JWT_SECRET, POSTGRES_PASSWORD:
#   cp .env.production.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Домен (основной)
# -----------------------------------------------------------------------------
SITE_URL=https://territory-interior.ru

# -----------------------------------------------------------------------------
# Frontend (build-time)
# -----------------------------------------------------------------------------
# Относительный путь — работает с обоими доменами (без CORS)
NEXT_PUBLIC_API_URL=/api/v1
# Тот же публичный origin, что SITE_URL — вшивается в образ при сборке (metadataBase / OG)
NEXT_PUBLIC_SITE_URL=https://territory-interior.ru
API_INTERNAL_URL=http://backend:3001
# Опционально: секрет для POST /api/revalidate без Bearer (CI, webhooks).
# В админке достаточно сессии — apiFetch уже шлёт Authorization.
# REVALIDATE_SECRET=

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
# Основной домен + зеркала (для CORS, если запросы приходят до редиректа)
CORS_ORIGIN=https://territory-interior.ru,https://xn-----mlcbabasabfm9bcdf6aacfbc3aeg7f4dwdza7f.xn--p1ai,https://601270.ru
# API_BASE_URL — для API и загрузок. Суффикс /api/v1 при формировании URL картинок убирается автоматически.
API_BASE_URL=https://territory-interior.ru/api/v1
JWT_SECRET=ОБЯЗАТЕЛЬНО_ЗАМЕНИТЕ_openssl_rand_hex_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# httpOnly refresh: в prod Secure=true (по умолчанию от NODE_ENV); для поддоменов задайте Domain
REFRESH_COOKIE_NAME=rt
REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_DOMAIN=.territory-interior.ru

# -----------------------------------------------------------------------------
# База данных
# -----------------------------------------------------------------------------
POSTGRES_USER=platform_user
POSTGRES_PASSWORD=ОБЯЗАТЕЛЬНО_ЗАМЕНИТЕ
POSTGRES_DB=platform_tir
# connection_limit=10 — ограничение пула Prisma (рекомендуется для prod, см. docs/VPS-OPTIMIZATION.md)
DATABASE_URL=postgresql://platform_user:ОБЯЗАТЕЛЬНО_ЗАМЕНИТЕ@postgres:5432/platform_tir?schema=public&connection_limit=10

# -----------------------------------------------------------------------------
# Супер-админ (для create-super-admin.cjs)
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@platform.local
SUPER_ADMIN_PASSWORD=Admin123!

# -----------------------------------------------------------------------------
# Yandex ID OAuth (вход через Яндекс)
# -----------------------------------------------------------------------------
# Без этих переменных кнопка «Войти через Яндекс» вернёт 400.
# Создайте приложение: https://oauth.yandex.com/client/new
# Платформа: Web services → Redirect URI: https://territory-interior.ru/auth/yandex/callback
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Email (восстановление пароля, письма заказов)
# -----------------------------------------------------------------------------
# MAIL_FROM=noreply@territory-interior.ru
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# -----------------------------------------------------------------------------
# Алерты о заполнении диска (scripts/disk-monitor.sh)
# Использует SMTP выше. Укажите email для получения уведомлений при 80%+ и 90%+
# -----------------------------------------------------------------------------
# DISK_ALERT_EMAIL=admin@territory-interior.ru

# -----------------------------------------------------------------------------
# Telegram: уведомления о заявках с форм (опционально)
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=

# -----------------------------------------------------------------------------
# Web Push: уведомления админки в установленном PWA на телефоне (опционально)
# Сгенерировать на сервере: npx --yes web-push generate-vapid-keys
# Или внутри контейнера backend после pull нового образа:
#   docker compose ... exec backend node -e "const w=require('web-push'); const k=w.generateVAPIDKeys(); console.log(k)"
# -----------------------------------------------------------------------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@territory-interior.ru

# -----------------------------------------------------------------------------
# GHCR
# -----------------------------------------------------------------------------
GHCR_IMAGE_PREFIX=ghcr.io/ruslan-skv
