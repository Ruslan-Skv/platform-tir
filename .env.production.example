# =============================================================================
# Platform TIR — production для territory-interior.ru и территория-интерьерных-решений.рф
# =============================================================================
# Скопируйте в .env и заполните JWT_SECRET, POSTGRES_PASSWORD:
#   cp .env.production.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Домен (основной)
# -----------------------------------------------------------------------------
SITE_URL=https://territory-interior.ru

# -----------------------------------------------------------------------------
# Frontend (build-time)
# -----------------------------------------------------------------------------
# Относительный путь — работает с обоими доменами (без CORS)
NEXT_PUBLIC_API_URL=/api/v1
API_INTERNAL_URL=http://backend:3001

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
# Оба домена: латиница + Punycode для кириллического
CORS_ORIGIN=https://territory-interior.ru,https://xn-----mlcbabasabfm9bcdf6aacfbc3aeg7f4dwdza7f.xn--p1ai
# API_BASE_URL — для API и загрузок. Суффикс /api/v1 при формировании URL картинок убирается автоматически.
API_BASE_URL=https://territory-interior.ru/api/v1
JWT_SECRET=ОБЯЗАТЕЛЬНО_ЗАМЕНИТЕ_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# База данных
# -----------------------------------------------------------------------------
POSTGRES_USER=platform_user
POSTGRES_PASSWORD=ОБЯЗАТЕЛЬНО_ЗАМЕНИТЕ
POSTGRES_DB=platform_tir
# connection_limit=10 — ограничение пула Prisma (рекомендуется для prod, см. docs/VPS-OPTIMIZATION.md)
DATABASE_URL=postgresql://platform_user:ОБЯЗАТЕЛЬНО_ЗАМЕНИТЕ@postgres:5432/platform_tir?schema=public&connection_limit=10

# -----------------------------------------------------------------------------
# Супер-админ (для create-super-admin.cjs)
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@platform.local
SUPER_ADMIN_PASSWORD=Admin123!

# -----------------------------------------------------------------------------
# Yandex ID OAuth (вход через Яндекс)
# -----------------------------------------------------------------------------
# Без этих переменных кнопка «Войти через Яндекс» вернёт 400.
# Создайте приложение: https://oauth.yandex.com/client/new
# Платформа: Web services → Redirect URI: https://territory-interior.ru/auth/yandex/callback
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Email (восстановление пароля, письма заказов)
# -----------------------------------------------------------------------------
# MAIL_FROM=noreply@territory-interior.ru
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# -----------------------------------------------------------------------------
# Telegram: уведомления о заявках с форм (TELEGRAM_BOT_TOKEN)
# + алерты о заполнении диска (TELEGRAM_ALERT_CHAT_ID для scripts/disk-monitor.sh)
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALERT_CHAT_ID=   # ID чата для алертов (узнать: @userinfobot в Telegram)

# -----------------------------------------------------------------------------
# GHCR
# -----------------------------------------------------------------------------
GHCR_IMAGE_PREFIX=ghcr.io/ruslan-skv
