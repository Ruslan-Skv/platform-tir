{
  "name": "backend",
  "version": "1.0.0",
  "description": "Platform TIR Backend API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" && prisma format",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix --max-warnings=100",
    "type-check": "tsc --noEmit",
    "postinstall": "node scripts/postinstall-prisma.js",
    "check-architecture": "node scripts/check-architecture.mjs",
    "validate": "prisma generate && npm run type-check && npm run lint && npm run format:check && npm run check-architecture",
    "validate:precommit": "npm run type-check && npm run lint && npm run format:check && npm run check-architecture",
    "validate:monorepo": "npm run validate && npm run secretlint && npm run validate:precommit --prefix ../frontend && npm run secretlint --prefix ../frontend",
    "validate:precommit:monorepo": "npm run validate:precommit && npm run secretlint && npm run validate:precommit --prefix ../frontend && npm run secretlint --prefix ../frontend",
    "secretlint": "node ./node_modules/secretlint/bin/secretlint.js \"src/**/*.{ts,js}\" \"prisma/**/*.ts\" \"*.{js,json}\" --format stylish",
    "prepare": "node -e \"if(process.env.HUSKY==='0'||process.env.CI){process.exit(0)}\" && cd .. && husky install backend/.husky || true",
    "husky:install": "cd .. && husky install backend/.husky",
    "commit": "cd .. && git add -A && cd backend && cz && node ../scripts/print-precommit-summary.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "prisma:seed-remont-kvartir": "ts-node -r tsconfig-paths/register prisma/seed-remont-kvartir-catalog.ts",
    "prisma:seed-product-card-badges": "ts-node -r tsconfig-paths/register prisma/seed-product-card-badges-only.ts",
    "prisma:seed-repair-contract-templates": "ts-node -r tsconfig-paths/register prisma/seed-repair-contract-template-presets.ts",
    "prisma:seed-windows-contract-templates": "ts-node -r tsconfig-paths/register prisma/seed-windows-contract-template-presets.ts",
    "prisma:seed-doors-contract-templates": "ts-node -r tsconfig-paths/register prisma/seed-doors-contract-template-presets.ts",
    "create-super-admin": "ts-node -r tsconfig-paths/register prisma/create-super-admin.ts"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.15.0",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/common": "^10.4.8",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.8",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.8",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^5.1.1",
    "@prisma/client": "^5.20.0",
    "@types/cheerio": "^0.22.35",
    "bcrypt": "^5.1.1",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "nodemailer": "^6.9.16",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.4.8",
    "@secretlint/secretlint-rule-preset-recommend": "^11.2.5",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.3.3",
    "prisma": "^5.20.0",
    "secretlint": "^11.2.5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
