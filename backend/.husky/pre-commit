#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

echo "🚀 Pre-commit: platform-tir (backend + frontend)"
echo ""

echo "🔍 lint-staged (format & fix staged files)..."
npx lint-staged || {
  echo "❌ lint-staged failed"
  exit 1
}

echo ""
echo "🔍 backend validate..."
npm run validate --prefix backend || {
  echo "❌ Backend validation failed (see backend/docs/ARCHITECTURE.md)"
  exit 1
}

npm run secretlint --prefix backend || {
  echo "❌ Secretlint failed (backend)"
  exit 1
}

echo ""
echo "🔍 frontend validate (precommit)..."
npm run validate:precommit --prefix frontend || {
  echo "❌ Frontend validation failed (see frontend/docs/ARCHITECTURE.md)"
  exit 1
}

echo ""
echo "✅ Pre-commit passed (backend + frontend)."
