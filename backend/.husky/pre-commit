#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# husky re-invokes this script with `sh -e`; handle failures explicitly below.
set +e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

SUMMARY_FILE="$ROOT/.git/precommit-summary.txt"
: > "$SUMMARY_FILE"

append_summary() {
  printf '%s\n' "$1" >> "$SUMMARY_FILE"
}

run_capture() {
  label=$1
  shift
  echo "🔍 $label..."
  output=$("$@" 2>&1)
  code=$?
  if [ $code -ne 0 ]; then
    printf '%s\n' "$output"
    echo "❌ $label failed (exit ${code})"
    return $code
  fi
  printf '%s' "$output"
  return 0
}

extract_backend_validate_summary() {
  printf '%s\n' "$1" | awk '
    /^✅/ || /^⚠/ || /^❌/ || /^✖/ || /^📋/ || /problem/ || /Критичных/ || /Архитектура/ {
      print
    }
  ' | tail -20
}

extract_frontend_validate_summary() {
  printf '%s\n' "$1" | awk '
    /^✅/ || /^📊/ || /^  ⚠/ || /^Итого:/ || /Архитектура frontend/ || /Критичных/ || /предупрежден/ {
      print
    }
  ' | tail -15
}

echo "🚀 Pre-commit: platform-tir (backend + frontend)"
echo ""

echo "🔍 lint-staged (format & fix staged files)..."
npx lint-staged --quiet
lint_staged_status=$?
if [ $lint_staged_status -ne 0 ]; then
  echo "❌ lint-staged failed (exit ${lint_staged_status})"
  exit 1
fi
append_summary "✅ lint-staged — staged: prettier · eslint · secretlint (backend+frontend code)"

backend_out=$(run_capture "backend validate" npm run validate --prefix backend)
backend_validate_status=$?
if [ $backend_validate_status -ne 0 ]; then
  printf '%s\n' "$backend_out"
  exit 1
fi
backend_summary=$(extract_backend_validate_summary "$backend_out")
append_summary ""
append_summary "── backend ──"
append_summary "✅ validate (type-check, lint, format, architecture)"
if [ -n "$backend_summary" ]; then
  append_summary "$backend_summary"
fi

frontend_out=$(run_capture "frontend validate (precommit)" npm run validate:precommit --prefix frontend)
frontend_validate_status=$?
if [ $frontend_validate_status -ne 0 ]; then
  printf '%s\n' "$frontend_out"
  exit 1
fi
frontend_summary=$(extract_frontend_validate_summary "$frontend_out")
append_summary ""
append_summary "── frontend ──"
append_summary "✅ validate:precommit (type-check, architecture; eslint/format — lint-staged на staged)"
if [ -n "$frontend_summary" ]; then
  append_summary "$frontend_summary"
fi

append_summary "✅ secretlint — проверка staged-файлов в lint-staged"

append_summary ""
append_summary "✅ Pre-commit passed (backend + frontend)."

echo ""
echo "✅ Pre-commit passed (backend + frontend)."
