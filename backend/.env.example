# # Только для локальной разработки при запуске бэкенда из папки backend (npm run start:dev).
# # В production переменные задаются в корне проекта (.env из .env.production.example) и передаются в контейнер через docker-compose.

# DATABASE_URL="postgresql://<user>:<password>@localhost:5432/territory?schema=public"

# # Rate limiting (DDoS protection): requests per TTL window per IP
# THROTTLE_LIMIT=100 // число запросов в окне (по умолчанию 100)
# THROTTLE_TTL=60 //  окно в секундах (по умолчанию 60)

# # Секрет для подписи access-JWT. Сгенерируйте свой:
# #   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET="<generate-a-unique-random-secret>"
# # Access JWT (короткий); клиент продлевает сессию через POST /auth/refresh.
# JWT_ACCESS_EXPIRES_IN=15m
# # Opaque refresh в БД (SHA-256); срок строки refresh.
# JWT_REFRESH_EXPIRES_IN=30d

# # Refresh в httpOnly cookie (имя, Secure, опционально Domain для поддоменов)
# REFRESH_COOKIE_NAME=rt
# REFRESH_COOKIE_SECURE=false
# # REFRESH_COOKIE_DOMAIN=.example.com
# ELASTICSEARCH_NODE="http://localhost:9200"

# # Публичный URL сайта (ссылки в письмах: восстановление пароля, заказ)
# SITE_URL="http://localhost:3000"

# # Отправка писем (восстановление пароля, заказ на email и др.)
# # Без SMTP письма не отправляются (логика отработает, но sendMail упадёт или будет в лог)
# MAIL_FROM="noreply@example.com"
# SMTP_HOST="localhost"
# SMTP_PORT="1025"
# # SMTP_USER=""
# # SMTP_PASS=""
# # Для разработки: MailHog (docker) слушает 1025. Для production: укажите SMTP вашего провайдера (Яндекс, Mail.ru, SendGrid и т.д.)

DATABASE_URL="postgresql://<user>:<password>@localhost:5432/territory?schema=public"

JWT_SECRET="<generate-a-unique-random-secret>"
JWT_ACCESS_EXPIRES_IN=15m
ELASTICSEARCH_NODE="http://localhost:9200"

SITE_URL=http://localhost:3000


SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@example.com



SUPER_ADMIN_EMAIL=admin@platform
SUPER_ADMIN_PASSWORD=<set-a-strong-password>

# Web Push для PWA (push-уведомления админки на телефоне)
# Сгенерировать: node -e "const w=require('web-push'); const k=w.generateVAPIDKeys(); console.log(k)"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
