  id            String   @id @default(cuid())
  supplierId    String
  snapshot      Json // Массив строк { rows: [...] }
  changedFields String[] @default([])
  action        String // UPDATE | ROLLBACK
  changedById   String
  changedAt     DateTime @default(now())

  supplier  Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  changedBy User     @relation("SupplierSettlementHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([supplierId])
  @@index([changedAt])
  @@map("supplier_settlement_history")
}

model ProductSupplier {
  id                     String    @id @default(cuid())
  productId              String
  supplierId             String
  supplierSku            String
  supplierPrice          Decimal   @db.Decimal(10, 2)
  supplierStock          Int       @default(0)
  supplierProductUrl     String? // Ссылка на товар у поставщика
  supplierPriceChangedAt DateTime? // Пометка: цена поставщика изменилась при последней синхронизации
  isMainSupplier         Boolean   @default(false)
  lastSyncAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  product                Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier               Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

model SupplierSyncLog {
  id              String     @id @default(cuid())
  supplierId      String
  status          SyncStatus
  productsAdded   Int        @default(0)
  productsUpdated Int        @default(0)
  productsRemoved Int        @default(0)
  errors          String?
  startedAt       DateTime   @default(now())
  completedAt     DateTime?
  supplier        Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_sync_logs")
}

model ShippingMethod {
  id              String   @id @default(cuid())
  name            String
  code            String   @unique
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  freeFromAmount  Decimal? @db.Decimal(10, 2)
  minDeliveryDays Int?
  maxDeliveryDays Int?
  isActive        Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orders          Order[]

  @@map("shipping_methods")
}

/// Настройки расчёта доставки: населённые пункты с фикс. стоимостью, грузчики по массе и габаритам.
model DeliveryConfig {
  id                           String               @id @default(cuid())
  deliveryPriceMurmansk        Decimal              @db.Decimal(10, 2) // Deprecated: используется deliverySettlements
  deliveryPricePerKmOutside    Decimal              @db.Decimal(10, 2) // Стоимость за 1 км для адресов вне списка, руб
  deliveryPaymentMode          String?              @default("WITH_ORDER") // WITH_ORDER = оплата с заказом, ON_SITE = оплата по месту
  moversPriceMurmansk          Decimal              @db.Decimal(10, 2) // Стоимость грузчиков в населённом пункте из списка (за 1 чел), руб
  moversPriceOutside           Decimal              @db.Decimal(10, 2) // Стоимость грузчиков за пределами списка (за 1 чел), руб
  moversKgPerPerson            Decimal              @db.Decimal(10, 2) // Кг на одного грузчика
  moversVolumePerPerson        Decimal?             @db.Decimal(10, 4) // м³ на одного грузчика (опционально)
  /// Роли, которым разрешено оформлять заказ для клиента (массив строк, напр. ["SUPER_ADMIN","ADMIN","MANAGER"]). null = по умолчанию все три.
  rolesAllowedOrderForCustomer Json?
  /// Время действия статуса «Заказ проверен» (минуты). После истечения заказ отменяется, товары возвращаются в корзину.
  approvalValidMinutes         Int                  @default(60)
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  settlements                  DeliverySettlement[]

  @@map("delivery_config")
}

/// Населённый пункт с фиксированной стоимостью доставки.
model DeliverySettlement {
  id        String         @id @default(cuid())
  configId  String
  config    DeliveryConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  name      String // Название населённого пункта
  price     Decimal        @db.Decimal(10, 2) // Стоимость доставки, руб
  order     Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("delivery_settlements")
}

model PaymentMethod {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  description String?
  icon        String?
  isActive    Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  payments    Payment[]

  @@map("payment_methods")
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  methodId        String
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  transactionId   String?
  gatewayResponse Json?
  paidAt          DateTime?
  refundedAt      DateTime?
  refundAmount    Decimal?      @db.Decimal(10, 2)
  refundReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  method          PaymentMethod @relation(fields: [methodId], references: [id])
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model SalesMetric {
  id             String   @id @default(cuid())
  date           DateTime @db.Date
  managerId      String?
  ordersCount    Int      @default(0)
  revenue        Decimal  @default(0) @db.Decimal(12, 2)
  avgOrderValue  Decimal  @default(0) @db.Decimal(10, 2)
  newCustomers   Int      @default(0)
  conversionRate Decimal  @default(0) @db.Decimal(5, 2)
  createdAt      DateTime @default(now())
  manager        User?    @relation(fields: [managerId], references: [id])

  @@unique([date, managerId])
  @@map("sales_metrics")
}

model MarketingChannel {
  id        String            @id @default(cuid())
  name      String
  code      String            @unique
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  metrics   MarketingMetric[]

  @@map("marketing_channels")
}

model MarketingMetric {
  id        String           @id @default(cuid())
  channelId String
  date      DateTime         @db.Date
  visits    Int              @default(0)
  leads     Int              @default(0)
  orders    Int              @default(0)
  revenue   Decimal          @default(0) @db.Decimal(12, 2)
  cost      Decimal          @default(0) @db.Decimal(10, 2)
  createdAt DateTime         @default(now())
  channel   MarketingChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, date])
  @@map("marketing_metrics")
}

/// Публичный каталог: вид элемента в блоке фильтров (атрибут / наличие / производитель).
enum CatalogFilterItemKind {
  ATTRIBUTE
  STOCK
  MANUFACTURER
}

/// Порядок значений внутри фильтра по атрибуту (витрина каталога).
enum CatalogFilterOptionsSort {
  /// По убыванию извлечённого числа («100 мм» выше «40 мм»); без числа — в конце, по алфавиту.
  NUMERIC_DESC
  /// По алфавиту (как раньше по умолчанию).
  TEXT_ASC
  /// Явный список значений (совпадение строки с карточки товара); остальные — после, по NUMERIC_DESC.
  MANUAL
}

/// Настройки блока фильтров категории (админка → Настройки → Блок фильтров).
model CatalogFilterBlock {
  id                 String                   @id @default(cuid())
  name               String                   @default("")
  categoryId         String                   @unique
  includeDescendants Boolean                  @default(true)
  sortOrder          Int                      @default(0)
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  category           Category                 @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  items              CatalogFilterBlockItem[]

  @@map("catalog_filter_blocks")
}

model CatalogFilterBlockItem {
  id                String                   @id @default(cuid())
  blockId           String
  kind              CatalogFilterItemKind
  attributeId       String?
  labelOverride     String?
  sortOrder         Int                      @default(0)
  /// Только для kind=ATTRIBUTE; для STOCK/MANUFACTURER не используется (оставлено значение по умолчанию).
  optionsSort       CatalogFilterOptionsSort @default(NUMERIC_DESC)
  /// Список значений в нужном порядке (только при optionsSort=MANUAL).
  manualOptionOrder Json?
  block             CatalogFilterBlock       @relation(fields: [blockId], references: [id], onDelete: Cascade)
  attribute         Attribute?               @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@map("catalog_filter_block_items")
}

model Category {
  id                        String                     @id @default(cuid())
  name                      String
  slug                      String                     @unique
  description               String?
  image                     String?
  parentId                  String?
  order                     Int                        @default(0)
  isActive                  Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  icon                      String?
  createdById               String?
  parent                    Category?                  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children                  Category[]                 @relation("CategoryTree")
  attributes                CategoryAttribute[]
  products                  Product[]
  catalogFilterBlock        CatalogFilterBlock?
  catalogHubPreviewSections CatalogHubPreviewSection[]
  createdBy                 User?                      @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("categories")
}

model CategoryAttribute {
  id          String    @id @default(cuid())
  categoryId  String
  attributeId String
  isRequired  Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, attributeId])
  @@map("category_attributes")
}

model Product {
  id                     String                         @id @default(cuid())
  name                   String
  slug                   String                         @unique
  description            String?
  sku                    String?                        @unique
  price                  Decimal                        @db.Decimal(10, 2)
  comparePrice           Decimal?                       @db.Decimal(10, 2)
  stock                  Int                            @default(0)
  /// При нулевом остатке: витрина «Под заказ» вместо «Товар закончился». Если остаток больше нуля — всегда «В наличии».
  onOrder                Boolean                        @default(false)
  isActive               Boolean                        @default(true)
  isFeatured             Boolean                        @default(false)
  isNew                  Boolean                        @default(false)
  isPartnerProduct       Boolean                        @default(false)
  partnerId              String?
  sortOrder              Int                            @default(0)
  categoryId             String
  images                 String[]
  videoUrl               String? // URL видеоролика о товаре (YouTube, Vimeo или свой хостинг)
  attributes             Json?
  seoTitle               String?
  seoDescription         String?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  createdById            String? // Кто создал карточку товара
  updatedById            String? // Кто последний изменил
  barcode                String?
  costPrice              Decimal?                       @db.Decimal(10, 2)
  height                 Decimal?                       @db.Decimal(8, 2)
  length                 Decimal?                       @db.Decimal(8, 2)
  manufacturerId         String?
  coatingMaterialId      String?
  canvasTypeId           String?
  doorThicknessId        String?
  weatherstripId         String?
  minStock               Int                            @default(0)
  seoKeywords            String[]
  shortDescription       String?
  weight                 Decimal?                       @db.Decimal(8, 3)
  width                  Decimal?                       @db.Decimal(8, 2)
  sizes                  String[]
  openingSide            String[]
  cartItems              CartItem[]
  orderItems             OrderItem[]
  orderItemsReplacedFrom OrderItem[]                    @relation("OrderItemReplacedFrom")
  suppliers              ProductSupplier[]
  category               Category                       @relation(fields: [categoryId], references: [id])
  manufacturer           Manufacturer?                  @relation(fields: [manufacturerId], references: [id])
  coatingMaterial        CoatingMaterial?               @relation(fields: [coatingMaterialId], references: [id])
  canvasType             CanvasType?                    @relation(fields: [canvasTypeId], references: [id])
  doorThickness          DoorThickness?                 @relation(fields: [doorThicknessId], references: [id])
  weatherstrip           Weatherstrip?                  @relation(fields: [weatherstripId], references: [id])
  partner                Partner?                       @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  createdBy              User?                          @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy              User?                          @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  reviews                Review[]
  wishlist               WishlistItem[]
  compareItems           CompareItem[]
  components             ProductComponent[]
  cardVariants           ProductCardVariant[]
  cardBadgeSelections    ProductCardBadgeOnProduct[]
  catalogHubPreviewPicks CatalogHubPreviewProductPick[]

  @@index([categoryId, isActive, sortOrder])
  @@map("products")
}

/// Справочник бэйджей карточки товара (слева от фото — JPG из настроек каталога).
model ProductCardBadgeDefinition {
  id          String                      @id @default(cuid())
  key         String                      @unique
  label       String
  description String?                     @db.Text
  imageUrl    String?
  sortOrder   Int                         @default(0)
  products    ProductCardBadgeOnProduct[]

  @@map("product_card_badge_definitions")
}

/// Выбранные для товара бэйджи (макс. 5 на товар), порядок = sortOrder.
model ProductCardBadgeOnProduct {
  id        String                     @id @default(cuid())
  productId String
  badgeId   String
  sortOrder Int                        @default(0)
  product   Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  badge     ProductCardBadgeDefinition @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([productId, badgeId])
  @@index([productId])
  @@map("product_card_badge_on_products")
}

/// Схожие товары в одной карточке (до 5): отличаются ценой, размером, фото, наименованием, цветом, доп. опцией (как на Wildberries/Озон).
model ProductCardVariant {
  id          String     @id @default(cuid())
  productId   String
  name        String // Наименование варианта
  price       Decimal    @db.Decimal(10, 2)
  image       String? // URL или base64
  size        String? // Размер
  color       String? // Цвет
  extraOption String? // Доп. опция
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]

  @@map("product_card_variants")
}

model ProductComponent {
  id        String     @id @default(cuid())
  productId String
  name      String // Наименование: коробка, наличник, добор, притворная планка
  type      String // Конкретный тип комплектующей
  price     Decimal    @db.Decimal(10, 2) // Стоимость за 1 шт.
  image     String? // Иконка/изображение комплектующего (base64 или URL)
  stock     Int        @default(0)
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@map("product_components")
}

model Order {
  id                           String             @id @default(cuid())
  userId                       String
  createdByManagerId           String? // Менеджер оформил заказ для покупателя
  customerEmail                String? // Email получателя (дублирует user.email для поиска)
  customerPhone                String? // Телефон покупателя (для заказов менеджера)
  customerFirstName            String? // Имя покупателя (для заказов менеджера)
  customerMiddleName           String? // Отчество покупателя (для заказов менеджера)
  customerLastName             String? // Фамилия покупателя (для заказов менеджера)
  processedByManagerId         String? // Менеджер, который обработал заказ
  sentToEmailAt                DateTime? // Когда заказ отправлен на email покупателя
  orderViewToken               String?            @unique // Подписанный токен для просмотра по ссылке из письма
  status                       OrderStatus        @default(PENDING)
  total                        Decimal            @db.Decimal(10, 2)
  subtotal                     Decimal            @db.Decimal(10, 2)
  tax                          Decimal            @db.Decimal(10, 2)
  shippingAddressId            String? // Опционально для заказов «на проверке» (до согласования)
  paymentStatus                PaymentStatus      @default(PENDING)
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt
  adminNotes                   String?
  cancelReason                 String?
  cancelledAt                  DateTime?
  customerNotes                String?
  deliveredAt                  DateTime?
  discount                     Decimal            @default(0) @db.Decimal(10, 2)
  orderNumber                  String             @unique
  refundAmount                 Decimal?           @db.Decimal(10, 2)
  refundReason                 String?
  refundedAt                   DateTime?
  shippedAt                    DateTime?
  shippingCost                 Decimal            @db.Decimal(10, 2)
  carryCost                    Decimal?           @db.Decimal(10, 2) // Стоимость грузчиков (оплата по месту и т.п.)
  moversCount                  Int? // Количество грузчиков (указывает админ)
  plannedDeliveryDate          DateTime?          @db.Date // Планируемая дата доставки (указывает админ)
  shippingMethodId             String?
  trackingNumber               String?
  returnedForCorrectionAt      DateTime? // Когда менеджер отправил заказ на доработку покупателю
  returnedForCorrectionComment String?            @db.Text // Комментарий при отправке на доработку
  approvedAt                   DateTime? // Когда заказ переведён в «Проверен»; действие 60 мин
  adminEditedAt                DateTime? // Когда админ вносил изменения (пометка «Отредактировано!» у покупателя)
  submittedForReviewAt         DateTime? // Дата и время приёма заказа на проверку (из корзины)
  deliveryType                 String? // TO_ENTRANCE | TO_APARTMENT — до подъезда или подъём в квартиру
  deliveryFloor                Int? // Этаж (при подъёме в квартиру)
  deliveryHasElevator          Boolean? // Есть лифт (при подъёме в квартиру)
  preferredDeliveryTime        String?            @db.Text // Когда покупателю удобно принять заказ
  items                        OrderItem[]
  orderServiceItems            OrderServiceItem[]
  shippingAddress              Address?           @relation(fields: [shippingAddressId], references: [id])
  shippingMethod               ShippingMethod?    @relation(fields: [shippingMethodId], references: [id])
  user                         User               @relation(fields: [userId], references: [id])
  createdByManager             User?              @relation("OrdersCreatedByManager", fields: [createdByManagerId], references: [id])
  processedByManager           User?              @relation("OrdersProcessedByManager", fields: [processedByManagerId], references: [id])
  payments                     Payment[]
  orderEvents                  OrderEvent[]

  @@map("orders")
}

/// События истории заказа (действия покупателя и менеджера) для блока «История заказа».
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  type      String // created, submitted_for_review, approved, returned_for_correction, cancelled, shipped, delivered, refunded, delivery_edited, customer_edited, item_comment_edited, sent_to_email, add_to_review, add_to_approved
  actor     String // customer | manager
  userId    String? // ID пользователя (менеджера или покупателя), если известен
  user      User?    @relation("OrderEventActor", fields: [userId], references: [id])

  @@index([orderId])
  @@map("order_events")
}

model OrderItem {
  id                    String   @id @default(cuid())
  orderId               String
  /// Обнуляется при удалении товара из каталога (позиция заказа и цена остаются в истории)
  productId             String?
  cardVariantId         String? // Вариант из «схожих товаров в карточке» (для истории)
  quantity              Int
  price                 Decimal  @db.Decimal(10, 2)
  size                  String?
  openingSide           String?
  managerComment        String?  @db.Text // Комментарий менеджера по пункту (для доработки покупателем)
  replacedFromProductId String? // Если менеджер заменил товар — ID исходного товара (для пометки покупателю)
  replacementNote       String?  @db.Text // Пометка о замене для покупателя
  createdAt             DateTime @default(now())
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product               Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  replacedFromProduct   Product? @relation("OrderItemReplacedFrom", fields: [replacedFromProductId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

/// Позиция услуг в заказе (Order). Услуги из корзины добавляются в тот же Order, что и товары.
model OrderServiceItem {
  id                   String             @id @default(cuid())
  orderId              String
  serviceCatalogItemId String
  name                 String // Название вида работ (денормализация)
  categoryName         String // Название категории (денормализация)
  roomName             String? // Название помещения (если расчёт делали по помещениям)
  unit                 String // Ед. изм.
  quantity             Decimal            @db.Decimal(12, 2)
  price                Decimal            @db.Decimal(12, 2)
  amount               Decimal            @db.Decimal(12, 2)
  createdAt            DateTime           @default(now())
  order                Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceCatalogItem   ServiceCatalogItem @relation(fields: [serviceCatalogItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([serviceCatalogItemId])
  @@map("order_service_items")
}

model Address {
  id         String      @id @default(cuid())
  userId     String
  type       AddressType @default(SHIPPING)
  firstName  String
  lastName   String
  phone      String
  street     String
  city       String
  region     String?
  postalCode String
  country    String      @default("RU")
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@map("addresses")
}

model CartItem {
  id            String              @id @default(cuid())
  userId        String
  productId     String?
  componentId   String?
  cardVariantId String? // Вариант из «схожих товаров в карточке»
  quantity      Float // Float для поддержки половинок
  size          String?
  openingSide   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  product       Product?            @relation(fields: [productId], references: [id], onDelete: Cascade)
  component     ProductComponent?   @relation(fields: [componentId], references: [id], onDelete: Cascade)
  cardVariant   ProductCardVariant? @relation(fields: [cardVariantId], references: [id], onDelete: SetNull)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, productId])
  @@index([userId, componentId])
  @@map("cart_items")
}

/// Элемент корзины — выбранные услуги из категории каталога услуг.
/// 1 CartServiceItem = 1 категория; счётчик корзины +1 за каждую категорию.
model CartServiceItem {
  id                       String                 @id @default(cuid())
  userId                   String
  serviceCatalogCategoryId String
  items                    Json // [{ itemId: string, quantity: number }]
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  user                     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category                 ServiceCatalogCategory @relation(fields: [serviceCatalogCategoryId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceCatalogCategoryId])
  @@index([userId])
  @@map("cart_service_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model CompareItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("compare_items")
}

model Review {
  id           String    @id @default(cuid())
  productId    String
  userId       String?
  userName     String
  userEmail    String? // Для гостевых отзывов
  rating       Int       @db.SmallInt
  comment      String?   @db.Text
  adminReply   String?   @db.Text // Ответ администратора
  adminReplyAt DateTime? // Когда написан ответ
  isApproved   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model UserCabinetBlock {
  id                       String   @id @default("main")
  showProfileSection       Boolean  @default(true) // Личные данные
  showOrdersSection        Boolean  @default(true) // Мои заказы
  showNotificationsSection Boolean  @default(true) // Уведомления
  showNotificationHistory  Boolean  @default(true) // История уведомлений (только чтение)
  showPasswordSection      Boolean  @default(true) // Смена пароля
  showQuickLinks           Boolean  @default(true) // Быстрые ссылки
  updatedAt                DateTime @updatedAt

  @@map("user_cabinet_block")
}

model ReviewsBlock {
  id                String   @id @default("main")
  enabled           Boolean  @default(true) // Включить отзывы и оценки
  showOnCards       Boolean  @default(true) // Показывать рейтинг на карточках товаров
  requirePurchase   Boolean  @default(false) // Только покупатели могут оставлять отзывы
  allowGuestReviews Boolean  @default(true) // Разрешить гостям оставлять отзывы
  requireModeration Boolean  @default(true) // Требовать модерацию перед публикацией
  updatedAt         DateTime @updatedAt

  @@map("reviews_block")
}

model CatalogBlock {
  id                          String   @id @default("main")
  defaultMobileCatalogColumns Int      @default(1) // 1 или 2 карточки в строке на мобильном (по умолчанию для сайта)
  updatedAt                   DateTime @updatedAt

  @@map("catalog_block")
}

/// Роли, которым показывать кнопку «Админка» на публичном сайте.
/// null = дефолт сервера. Либо JSON-массив ролей (одинаково для десктопа и мобилки), либо объект { desktop, mobile } с массивами или null по каналам.
model SitePublicConfig {
  id                 String   @id @default("main")
  rolesShowAdminLink Json?
  updatedAt          DateTime @updatedAt

  @@map("site_public_config")
}

model NotificationSound {
  id        String   @id @default(cuid())
  name      String // Название звука
  fileUrl   String // URL файла (/uploads/notification-sounds/...)
  createdAt DateTime @default(now())

  @@map("notification_sounds")
}

model UserAdminNotificationOverride {
  id                        String   @id @default(cuid())
  userId                    String   @unique // Персональные настройки для пользователя (переопределяют роль)
  soundEnabled              Boolean  @default(true)
  soundVolume               Int      @default(70)
  soundType                 String   @default("beep")
  customSoundUrl            String?
  desktopNotifications      Boolean  @default(false)
  checkIntervalSeconds      Int      @default(60)
  notifyOnReviews           Boolean  @default(true)
  notifyOnOrders            Boolean  @default(true)
  notifyOnSupportChat       Boolean  @default(true)
  notifyOnMeasurementForm   Boolean  @default(true)
  notifyOnCallbackForm      Boolean  @default(true)
  notifyOnKnowledgeFeedback Boolean  @default(true)
  updatedAt                 DateTime @updatedAt
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_admin_notification_override")
}

model AdminPushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_push_subscriptions")
}

model AdminNotificationsBlock {
  id                        String   @id @default(cuid())
  role                      String?  @unique // null = по умолчанию для всех, иначе роль (ADMIN, MODERATOR и т.д.)
  soundEnabled              Boolean  @default(true) // Звук при событиях
  soundVolume               Int      @default(70) // Громкость 0-100
  soundType                 String   @default("beep") // beep, ding, chime, bell или custom
  customSoundUrl            String? // URL загруженного звука (при soundType=custom)
  desktopNotifications      Boolean  @default(false) // Браузерные уведомления
  checkIntervalSeconds      Int      @default(60) // Интервал проверки (сек)
  notifyOnReviews           Boolean  @default(true) // Уведомления о новых отзывах
  notifyOnOrders            Boolean  @default(true) // Уведомления о новых заказах
  notifyOnSupportChat       Boolean  @default(true) // Уведомления о сообщениях в чате
  notifyOnMeasurementForm   Boolean  @default(true) // Уведомления о записи на замер
  notifyOnCallbackForm      Boolean  @default(true) // Уведомления о заказе обратного звонка
  notifyOnKnowledgeFeedback Boolean  @default(true) // Обратная связь по обучающей платформе
  updatedAt                 DateTime @updatedAt

  @@map("admin_notifications_block")
}

model FormSubmission {
  id            String   @id @default(cuid())
  type          String // "measurement" | "callback" | "director"
  name          String
  phone         String
  email         String?
  address       String?
  preferredDate String?
  preferredTime String
  productType   String? // для director — тема (subject)
  comment       String?  @db.Text
  subject       String? // тема письма для type=director
  createdAt     DateTime @default(now())

  @@map("form_submissions")
}

// --- CRM: Направления ---
model CrmDirection {
  id                              String                           @id @default(cuid())
  name                            String
  slug                            String                           @unique
  isActive                        Boolean                          @default(true)
  sortOrder                       Int                              @default(0)
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  measurements                    Measurement[]
  measurementAdditionalDirections MeasurementAdditionalDirection[]
  contracts                       Contract[]

  @@map("crm_directions")
}

model MeasurementAdditionalDirection {
  measurementId String
  directionId   String
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  measurement Measurement  @relation(fields: [measurementId], references: [id], onDelete: Cascade)
  direction   CrmDirection @relation(fields: [directionId], references: [id], onDelete: Cascade)

  @@id([measurementId, directionId])
  @@index([measurementId])
  @@map("measurement_additional_directions")
}

model InstallerMaster {
  id        String   @id @default(cuid())
  direction String
  fullName  String
  grade     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([direction])
  @@map("installer_masters")
}

// --- CRM: Замеры ---
model Measurement {
  id              String            @id @default(cuid())
  managerId       String
  receptionDate   DateTime          @db.Date
  executionDate   DateTime?         @db.Date
  surveyorId      String?
  directionId     String?
  customerName    String
  customerAddress String?           @db.Text
  customerPhone   String
  comments        String?           @db.Text
  status          MeasurementStatus @default(NEW)
  customerId      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  manager              User                             @relation("MeasurementManager", fields: [managerId], references: [id], onDelete: Restrict)
  surveyor             User?                            @relation("MeasurementSurveyor", fields: [surveyorId], references: [id], onDelete: SetNull)
  direction            CrmDirection?                    @relation(fields: [directionId], references: [id], onDelete: SetNull)
  additionalDirections MeasurementAdditionalDirection[]
  customer             Customer?                        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contract             Contract?                        @relation("MeasurementToContract")
  history              MeasurementHistory[]

  @@index([managerId])
  @@index([status])
  @@index([receptionDate])
  @@map("measurements")
}

model MeasurementHistory {
  id            String   @id @default(cuid())
  measurementId String
  snapshot      Json // Полное состояние замера до изменения
  changedFields String[] @default([]) // Список изменённых полей для UPDATE
  action        String // UPDATE | ROLLBACK
  changedById   String
  changedAt     DateTime @default(now())

  measurement Measurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)
  changedBy   User        @relation("MeasurementHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([measurementId])
  @@index([changedAt])
  @@map("measurement_history")
}

// --- CRM: Договоры ---
// --- Комплексные объекты (группы договоров) ---
model ComplexObject {
  id             String   @id @default(cuid())
  name           String // Название объекта (например, адрес или имя клиента)
  customerName   String? // ФИО заказчика
  customerPhones String[] @default([]) // Телефоны заказчика (может быть несколько)
  address        String?  @db.Text // Адрес объекта
  notes          String?  @db.Text
  hasElevator    Boolean? // Есть ли лифт
  floor          Int? // Этаж
  officeId       String?
  managerId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  office    Office?                @relation(fields: [officeId], references: [id], onDelete: SetNull)
  manager   User?                  @relation("ComplexObjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  contracts Contract[]
  history   ComplexObjectHistory[]

  @@index([officeId])
  @@index([managerId])
  @@map("complex_objects")
}

model ComplexObjectHistory {
  id              String   @id @default(cuid())
  complexObjectId String
  snapshot        Json
  changedFields   String[] @default([])
  action          String // UPDATE | ROLLBACK
  changedById     String
  changedAt       DateTime @default(now())

  complexObject ComplexObject @relation(fields: [complexObjectId], references: [id], onDelete: Cascade)
  changedBy     User          @relation("ComplexObjectHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([complexObjectId])
  @@index([changedAt])
  @@map("complex_object_history")
}

model Contract {
  id                       String         @id @default(cuid())
  contractNumber           String         @unique
  contractDate             DateTime       @db.Date
  status                   ContractStatus @default(DRAFT)
  directionId              String?
  managerId                String?
  deliveryId               String?
  surveyorId               String?
  officeId                 String?
  complexObjectId          String?
  validityStart            DateTime?      @db.Date
  validityEnd              DateTime?      @db.Date
  contractDurationDays     Int? // Срок договора (число дней)
  contractDurationType     String? // CALENDAR | WORKING — календарные или рабочие дни
  installationDate         DateTime?      @db.Date
  installationDurationDays Int? // Продолжительность монтажа в днях
  deliveryDate             DateTime?      @db.Date
  customerName             String?
  customerAddress          String?        @db.Text
  customerPhone            String?
  customerId               String?
  discount                 Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount              Decimal        @db.Decimal(12, 2)
  advanceAmount            Decimal        @default(0) @db.Decimal(12, 2)
  notes                    String?        @db.Text
  source                   String?
  preferredExecutorId      String?
  measurementId            String?        @unique
  actWorkStartDate         DateTime?      @db.Date
  actWorkEndDate           DateTime?      @db.Date
  actWorkStartImages       String[]       @default([])
  actWorkEndImages         String[]       @default([])
  goodsTransferDate        DateTime?      @db.Date
  installers               String[]       @default([])
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  direction        CrmDirection?             @relation(fields: [directionId], references: [id], onDelete: SetNull)
  manager          User?                     @relation("ContractManager", fields: [managerId], references: [id], onDelete: SetNull)
  surveyor         User?                     @relation("ContractSurveyor", fields: [surveyorId], references: [id], onDelete: SetNull)
  customer         Customer?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)
  measurement      Measurement?              @relation("MeasurementToContract", fields: [measurementId], references: [id], onDelete: SetNull)
  office           Office?                   @relation(fields: [officeId], references: [id], onDelete: SetNull)
  complexObject    ComplexObject?            @relation(fields: [complexObjectId], references: [id], onDelete: SetNull)
  advances         ContractAdvance[]
  amendments       ContractAmendment[]
  payments         ContractPayment[]
  history          ContractHistory[]
  documentPackages ContractDocumentPackage[]

  @@index([managerId])
  @@index([status])
  @@index([contractDate])
  @@index([officeId])
  @@index([complexObjectId])
  @@map("contracts")
}

model ContractHistory {
  id            String   @id @default(cuid())
  contractId    String
  snapshot      Json // Состояние договора до изменения
  changedFields String[] @default([])
  action        String // UPDATE | ROLLBACK
  changedById   String
  changedAt     DateTime @default(now())

  contract  Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  changedBy User     @relation("ContractHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([contractId])
  @@index([changedAt])
  @@map("contract_history")
}

model ContractAdvance {
  id         String   @id @default(cuid())
  contractId String
  amount     Decimal  @db.Decimal(12, 2)
  paidAt     DateTime @db.Date
  notes      String?  @db.Text
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("contract_advances")
}

model ContractAmendment {
  id                   String    @id @default(cuid())
  contractId           String
  number               Int? // Номер д/с по порядку (1, 2, 3...)
  amount               Decimal   @db.Decimal(12, 2) // изменение стоимости: +, -, 0
  discount             Decimal   @default(0) @db.Decimal(12, 2) // скидка по д/с
  date                 DateTime  @db.Date
  extendsValidityTo    DateTime? @db.Date // deprecated, см. durationAdditionDays
  durationAdditionDays Int? // дней к сроку договора (0/null = без изменений)
  durationAdditionType String? // CALENDAR | WORKING
  notes                String?   @db.Text
  contract             Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@map("contract_amendments")
}

model ContractPayment {
  id               String      @id @default(cuid())
  contractId       String
  paymentDate      DateTime    @db.Date
  amount           Decimal     @db.Decimal(12, 2)
  collectionAmount Decimal?    @db.Decimal(12, 2)
  paymentForm      PaymentForm
  paymentType      PaymentType
  managerId        String?
  notes            String?     @db.Text
  createdAt        DateTime    @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  manager  User?    @relation(fields: [managerId], references: [id], onDelete: SetNull)

  @@index([contractId])
  @@index([paymentDate])
  @@map("contract_payments")
}

/// Пакет документов для оформления договора (аналог книги Excel: вкладка «Данные» + сгенерированные вкладки).
enum ContractDocumentPackageKind {
  REPAIR
  WINDOWS
  DOORS
  CEILINGS
  BLINDS
  FURNITURE
}

/// Стадия оформления пакета (например «договор заключён» — для учёта менеджером).
enum ContractDocumentPackageStatus {
  IN_PROGRESS
  CONTRACT_CONCLUDED
  REFUSED
}

/// Объект (группа договоров по адресу/заказчику): все направления оформления договоров.
model ContractDocumentObject {
  id           String   @id @default(cuid())
  name         String
  customerName String?
  address      String?  @db.Text
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  packages ContractDocumentPackage[]

  @@map("contract_document_objects")
}

model ContractDocumentPackage {
  id               String                        @id @default(cuid())
  kind             ContractDocumentPackageKind
  title            String?
  status           ContractDocumentPackageStatus @default(IN_PROGRESS)
  /// Все редактируемые поля вкладки «Данные» и прочие структурированные данные (смета и т.д.).
  formData         Json                          @default("{}")
  /// Связь с договором в учётной системе (таблица `Contract`).
  crmContractId    String?
  /// Группа «объект» (несколько пакетов / направлений на одном адресе).
  documentObjectId String?
  createdById      String?
  deletedAt        DateTime?                     @map("deleted_at")
  deletedById      String?                       @map("deleted_by_id")
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  documentObject  ContractDocumentObject?          @relation(fields: [documentObjectId], references: [id], onDelete: SetNull)
  createdBy       User?                            @relation("ContractDocumentPackagesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  deletedBy       User?                            @relation("ContractDocumentPackagesDeleted", fields: [deletedById], references: [id], onDelete: SetNull)
  crmContract     Contract?                        @relation(fields: [crmContractId], references: [id], onDelete: SetNull)
  versions        ContractDocumentPackageVersion[]
  payments        ContractDocumentPackagePayment[]
  paymentInvoices ContractDocumentPaymentInvoice[]

  @@index([kind])
  @@index([createdAt])
  @@index([crmContractId])
  @@index([documentObjectId])
  @@index([deletedAt])
  @@map("contract_document_packages")
}

/// Фактические оплаты заказчика по пакету документов (ремонт и др.): журнал для остатка и аналитики.
model ContractDocumentPackagePayment {
  id             String      @id @default(cuid())
  packageId      String
  paymentDate    DateTime    @db.Date
  amount         Decimal     @db.Decimal(12, 2)
  paymentForm    PaymentForm
  /// PREPAYMENT — при заключении (в т.ч. 70%, «нулевой» договор и т.д.); AMENDMENT — оплата по Д/с; FINAL — окончательный расчёт; ADVANCE — прочие частичные.
  paymentType    PaymentType
  /// Для paymentType AMENDMENT: номер Д/с 1…5.
  addendumNumber Int?
  /// За что оплачено (основание / пояснение для ПКО и внутреннего учёта).
  basis          String?     @db.Text
  notes          String?     @db.Text
  recordedById   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  package    ContractDocumentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  recordedBy User?                   @relation("ContractDocumentPackagePaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([packageId])
  @@index([paymentDate])
  @@map("contract_document_package_payments")
}

/// Выставленные счета на оплату по договорам (единая нумерация по всей организации).
model ContractDocumentPaymentInvoice {
  id             String      @id @default(cuid())
  packageId      String
  /// Порядковый номер счёта в общей нумерации (отображается как № счёта).
  sequenceNumber Int         @unique
  invoiceDate    DateTime    @db.Date
  amount         Decimal     @db.Decimal(12, 2)
  paymentType    PaymentType
  addendumNumber Int?
  basis          String      @db.Text
  /// Позиции счёта: [{ name, quantity, unit, vatLabel, unitPrice, amount }, ...]
  lineItems      Json        @default("[]")
  /// Id из formData.issuedInvoices[] до миграции в БД.
  legacyFormId   String?
  issuedById     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  package  ContractDocumentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  issuedBy User?                   @relation("ContractDocumentPaymentInvoiceIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)

  @@unique([packageId, legacyFormId])
  @@index([packageId])
  @@index([invoiceDate])
  @@map("contract_document_payment_invoices")
}

/// Счётчик для атомарной выдачи sequenceNumber (одна строка id = global).
model ContractDocumentPaymentInvoiceCounter {
  id    String @id @default("global")
  value Int    @default(0)

  @@map("contract_document_payment_invoice_counter")
}

/// Снимок пакета документов (история версий при явном сохранении и при восстановлении).
model ContractDocumentPackageVersion {
  id            String                        @id @default(cuid())
  packageId     String
  versionNumber Int
  title         String?
  status        ContractDocumentPackageStatus
  formData      Json                          @default("{}")
  crmContractId String?
  savedById     String?
  createdAt     DateTime                      @default(now())

  package ContractDocumentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  savedBy User?                   @relation("ContractDocumentPackageVersionSavedBy", fields: [savedById], references: [id], onDelete: SetNull)

  @@unique([packageId, versionNumber])
  @@index([packageId, createdAt])
  @@map("contract_document_package_versions")
}

/// История изменений общего списка расчётов по направлению (например, "Ремонт").
model ContractDocumentEstimatePresetsHistory {
  id            String                      @id @default(cuid())
  kind          ContractDocumentPackageKind
  items         Json                        @default("[]")
  groups        Json                        @default("[]")
  changedFields String[]                    @default([])
  action        String // CREATE | UPDATE | ROLLBACK
  changedAt     DateTime                    @default(now())
  changedById   String?

  changedBy User? @relation("ContractDocumentEstimatePresetsHistoryChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([kind, changedAt])
  @@index([changedById])
  @@map("contract_document_estimate_presets_history")
}

/// Общий шаблон HTML для вкладки документа (например договор «Ремонт») — подставляется всем пакетам, у которых нет своего переопределения.
model ContractDocumentGlobalTemplate {
  id          String                      @id @default(cuid())
  kind        ContractDocumentPackageKind
  tab         String
  html        String                      @db.Text
  updatedById String?
  updatedAt   DateTime                    @updatedAt

  updatedBy User? @relation("GlobalContractTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([kind, tab])
  @@map("contract_document_global_templates")
}

/// Срок договора по умолчанию (рабочие дни) по направлению: REPAIR, WINDOWS, …
model ContractDocumentRepairSettings {
  kind                          ContractDocumentPackageKind @id
  defaultWorkPeriodDays         Int                         @default(60)
  /// Наценка при расчёте заказ-наряда «Окна» (вычитается из цены счёт-заказа), %.
  windowsWorkOrderMarkupPercent Int                         @default(33)
  updatedById                   String?
  updatedAt                     DateTime                    @updatedAt

  updatedBy User? @relation("ContractDocumentRepairSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("contract_document_repair_settings")
}

enum MeasurementStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
