  updatedBy  User?                     @relation("RepairScheduleProjectUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  entries    RepairScheduleEntry[]
  bellEvents RepairScheduleBellEvent[]

  @@index([status])
  @@index([installerId])
  @@index([packageId])
  @@index([contractId])
  @@index([updatedAt])
  @@map("repair_schedule_projects")
}

