  workPeriodDays   Int?
  /// Дата подписания акта начала работ — от неё считается срок.
  workStartActDate DateTime?                   @db.Date
  /// Фактическое окончание по акту сдачи-приёмки.
  workCloseActDate DateTime?                   @db.Date
  plannedStartDate DateTime?                   @db.Date
