// --- Офисы ---
model Office {
  id                    String   @id @default(cuid())
  name                  String // Название офиса (например, "Главный офис", "Офис на Ленина")
  prefix                String? // Префикс офиса (для нумерации договоров и т.п.)
  address               String?  @db.Text // Адрес офиса
  phone                 String? // Телефон офиса
  isActive              Boolean  @default(true)
  sortOrder             Int      @default(0)
  allowedIps            String[] @default([])
  skipWorkDayIpCheck    Boolean  @default(false)
  workDayStartTime      String   @default("09:00")
  workDayEndTime        String   @default("18:00")
  workDaysOfWeek        Int[]    @default([1, 2, 3, 4, 5])
  gracePeriodMinutes    Int      @default(10)
  workDayWeeklySchedule Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  contracts      Contract[]
  complexObjects ComplexObject[]
  otherExpenses  OfficeOtherExpense[]
  incassations   OfficeIncassation[]
  history        OfficeHistory[]
  users          User[]
  workDays       WorkDay[]

  @@index([isActive])
  @@map("offices")
}

model OfficeHistory {
  id            String   @id @default(cuid())
  officeId      String
  snapshot      Json
  changedFields String[] @default([])
  action        String // UPDATE | ROLLBACK
  changedById   String
  changedAt     DateTime @default(now())

  office    Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  changedBy User   @relation("OfficeHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([officeId])
  @@index([changedAt])
  @@map("office_history")
}

model OfficeOtherExpense {
  id               String   @id @default(cuid())
  officeId         String
  amount           Decimal  @db.Decimal(12, 2)
  collectionAmount Decimal? @db.Decimal(12, 2)
  expenseDate      DateTime @db.Date
  description      String?  @db.Text
  createdById      String?
  createdAt        DateTime @default(now())

  office    Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([officeId])
  @@index([expenseDate])
  @@map("office_other_expenses")
}

model OfficeIncassation {
  id              String   @id @default(cuid())
  officeId        String
  amount          Decimal  @db.Decimal(12, 2)
  incassationDate DateTime @db.Date
  incassator      String?  @db.VarChar(500)
  notes           String?  @db.Text
  createdById     String?
  createdAt       DateTime @default(now())

  office    Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([officeId])
  @@index([incassationDate])
  @@map("office_incassations")
}

/// Настройки превью на хабе каталога /catalog/products (без ?branch=)
model CatalogHubPreviewSettings {
  id               String                     @id @default("main")
  productsPerGroup Int                        @default(6)
  updatedAt        DateTime                   @updatedAt
  sections         CatalogHubPreviewSection[]

  @@map("catalog_hub_preview_settings")
}

/// Раздел превью: категория верхнего уровня с подборкой товаров
model CatalogHubPreviewSection {
  id         String   @id @default(cuid())
  settingsId String   @default("main")
  categoryId String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  settings     CatalogHubPreviewSettings      @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  category     Category                       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productPicks CatalogHubPreviewProductPick[]

  @@unique([settingsId, categoryId])
  @@map("catalog_hub_preview_sections")
}

/// Ручной подбор товаров для раздела превью (featured = популярное, new = новинки)
model CatalogHubPreviewProductPick {
  id        String @id @default(cuid())
  sectionId String
  productId String
  mode      String
  sortOrder Int    @default(0)

  section CatalogHubPreviewSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sectionId, productId, mode])
  @@map("catalog_hub_preview_product_picks")
}

/// Волна / кампания подбора менеджеров по продажам
model RecruitmentCampaign {
  id                  String                    @id @default(cuid())
  title               String
  status              RecruitmentCampaignStatus @default(OPEN)
  startedAt           DateTime                  @default(now())
  closedAt            DateTime?
  notes               String?                   @db.Text
  selectedCandidateId String?                   @unique
  createdById         String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  selectedCandidate   SalesCandidate?           @relation("CampaignSelectedCandidate", fields: [selectedCandidateId], references: [id], onDelete: SetNull)
  candidates          SalesCandidate[]          @relation("CampaignCandidates")
  createdBy           User?                     @relation("RecruitmentCampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([startedAt])
  @@map("recruitment_campaigns")
}

enum RecruitmentCampaignStatus {
  OPEN
  CLOSED
}

/// Кандидат на должность менеджера по продажам
model SalesCandidate {
  id                         String               @id @default(cuid())
  campaignId                 String
  lastName                   String
  firstName                  String
  middleName                 String?
  birthDate                  DateTime?
  phone                      String
  email                      String?
  city                       String?
  address                    String?
  educationLevel             String?
  educationInstitution       String?
  educationSpecialty         String?
  educationYear              Int?
  additionalEducation        String?              @db.Text
  totalExperienceYears       Float?
  salesExperienceYears       Float?
  workHistory                Json?
  industryExperience         String[]             @default([])
  salesAchievements          String?              @db.Text
  communicationSkill         Int?
  stressResistance           Int?
  motivation                 Int?
  teamworkSkill              Int?
  selfOrganization           Int?
  pcSkill                    Int?
  presentationSkill          Int?
  motivationReason           String?              @db.Text
  salaryExpectation          String?
  availableFrom              DateTime?
  hasDriversLicense          Boolean?
  hasPersonalCar             Boolean?
  readyForTravel             Boolean?
  plannedTenure              String?
  readyToStudyWorkInfo       Boolean?
  readyForContinuousLearning Boolean?
  productKnowledge           String?              @db.Text
  interviewDate              DateTime?
  interviewScore             Int?
  interviewNotes             String?              @db.Text
  adminNotes                 String?              @db.Text
  resumeFileUrl              String?
  resumeFileName             String?
  resumeParsedText           String?              @db.Text
  resumeParsedData           Json?
  traineeUserId              String?              @unique
  status                     SalesCandidateStatus @default(NEW)
  overallScore               Float?
  createdById                String?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  campaign                   RecruitmentCampaign  @relation("CampaignCandidates", fields: [campaignId], references: [id], onDelete: Restrict)
  selectedInCampaign         RecruitmentCampaign? @relation("CampaignSelectedCandidate")
  traineeUser                User?                @relation("SalesCandidateTrainee", fields: [traineeUserId], references: [id], onDelete: SetNull)
  createdBy                  User?                @relation("SalesCandidateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([status])
  @@index([overallScore])
  @@index([createdAt])
  @@map("sales_candidates")
}

enum SalesCandidateStatus {
  NEW
  QUESTIONNAIRE
  INTERVIEW
  TRAINING
  TEST_TASK
  REJECTED
  HIRED
}

// --- Учёт рабочего дня ---
enum WorkDayStatus {
  OPEN
  CLOSED
  AUTO_CLOSED
}

enum WorkDayCloseReason {
  MANUAL
  AUTO_AT_DEADLINE
  REPORTED_NEXT_DAY
}

model WorkDaySettings {
  id                        String     @id @default("main")
  isEnabled                 Boolean    @default(true)
  trackedRoles              UserRole[] @default([MANAGER])
  blockAdminWithoutWorkDay  Boolean    @default(true)
  requireOfficeIp           Boolean    @default(true)
  blockMobileDevices        Boolean    @default(true)
  autoCloseHour             Int        @default(22)
  autoCloseMinute           Int        @default(0)
  defaultGracePeriodMinutes Int        @default(10)
  greetingMessages          String[]   @default(["Доброго дня, {имя}! Желаем продуктивной работы.", "С добрым утром, {имя}! Отличного рабочего дня!", "{имя}, желаем хорошего дня и отличной работы!"])
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt

  @@map("work_day_settings")
}

model WorkDay {
  id                      String              @id @default(cuid())
  userId                  String
  officeId                String?
  workDate                DateTime            @db.Date
  status                  WorkDayStatus       @default(OPEN)
  startedAt               DateTime
  endedAt                 DateTime?
  closeReason             WorkDayCloseReason?
  autoClosedAt            DateTime?
  startedFromIp           String?
  startedFromUserAgent    String?             @db.Text
  endedFromIp             String?
  lateMinutes             Int                 @default(0)
  earlyLeaveMinutes       Int                 @default(0)
  reportedEndAt           DateTime?
  notifiedLateAt          DateTime?
  notifiedEarlyLeaveAt    DateTime?
  notifiedAutoClosedAt    DateTime?
  notifiedReportedCloseAt DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  office   Office?          @relation(fields: [officeId], references: [id], onDelete: SetNull)
  absences WorkDayAbsence[]

  @@unique([userId, workDate])
  @@index([userId])
  @@index([officeId])
  @@index([workDate])
  @@index([status])
  @@map("work_days")
}

model WorkDayAbsence {
  id        String    @id @default(cuid())
  workDayId String
  startedAt DateTime
  endedAt   DateTime?
  reason    String?
  comment   String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  workDay WorkDay @relation(fields: [workDayId], references: [id], onDelete: Cascade)

  @@index([workDayId])
  @@map("work_day_absences")
}

enum WorkDayRequestType {
  DAY_OFF
  EARLY_LEAVE
  LATE_ARRIVAL
}

enum WorkDayRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model WorkDayRequest {
  id              String               @id @default(cuid())
  userId          String
  type            WorkDayRequestType
  status          WorkDayRequestStatus @default(PENDING)
  requestDate     DateTime             @db.Date
  proposedEndTime String? // HH:mm — уход (EARLY_LEAVE) или приход (LATE_ARRIVAL)
  comment         String?              @db.Text
  reviewedById    String?
  reviewedAt      DateTime?
  reviewComment   String?              @db.Text
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user       User  @relation("WorkDayRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("WorkDayRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([requestDate])
  @@index([type, status, requestDate])
  @@map("work_day_requests")
}

enum KanbanCardPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Канбан-доска команды (админка → Канбан-доска).
model KanbanBoard {
  id          String         @id @default(cuid())
  name        String
  description String?        @db.Text
  color       String?
  sortOrder   Int            @default(0)
  createdById String
  deletedAt   DateTime?      @map("deleted_at")
  deletedById String?        @map("deleted_by_id")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   User           @relation("KanbanBoardCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  deletedBy   User?          @relation("KanbanBoardDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  columns     KanbanColumn[]

  @@index([sortOrder])
  @@index([createdById])
  @@index([deletedAt])
  @@map("kanban_boards")
}

model KanbanColumn {
  id        String       @id @default(cuid())
  boardId   String
  name      String
  color     String?
  /// WIP-лимит колонки (null = без лимита)
  wipLimit  Int?
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  board     KanbanBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     KanbanCard[]

  @@index([boardId, sortOrder])
  @@map("kanban_columns")
}

model KanbanCard {
  id              String                 @id @default(cuid())
  columnId        String
  title           String
  description     String?                @db.Text
  priority        KanbanCardPriority     @default(MEDIUM)
  labels          String[]               @default([])
  dueDate         DateTime?
  assigneeId      String?
  sortOrder       Int                    @default(0)
  /// Чек-лист: [{ id, text, done }]
  checklist       Json?
  createdById     String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  column          KanbanColumn           @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee        User?                  @relation("KanbanCardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy       User                   @relation("KanbanCardCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  comments        KanbanCardComment[]
  messengerThread MessengerConversation?
  bellEvents      KanbanCardBellEvent[]

  @@index([columnId, sortOrder])
  @@index([assigneeId])
  @@index([dueDate])
  @@map("kanban_cards")
}

/// Персональные события колокольчика по карточкам канбана.
model KanbanCardBellEvent {
  id          String     @id @default(cuid())
  recipientId String
  cardId      String
  kind        String /// assigned | moved | commented | due_changed | priority
  title       String
  message     String     @db.Text
  href        String
  createdAt   DateTime   @default(now())
  recipient   User       @relation("KanbanCardBellRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  card        KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([cardId])
  @@map("kanban_card_bell_events")
}

model KanbanCardComment {
  id        String     @id @default(cuid())
  cardId    String
  authorId  String
  body      String     @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  card      KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author    User       @relation("KanbanCardCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([cardId, createdAt])
  @@map("kanban_card_comments")
}

enum MessengerConversationType {
  DIRECT
  CHANNEL
  KANBAN_CARD
}

/// Командный мессенджер админки: личные чаты, каналы, треды канбан-карточек.
model MessengerConversation {
  id           String                    @id @default(cuid())
  type         MessengerConversationType
  title        String?
  /// Системный канал «Общий» (не удаляется в MVP)
  isGeneral    Boolean                   @default(false)
  kanbanCardId String?                   @unique
  createdById  String
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  createdBy    User                      @relation("MessengerConversationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  kanbanCard   KanbanCard?               @relation(fields: [kanbanCardId], references: [id], onDelete: Cascade)
  members      MessengerMember[]
  messages     MessengerMessage[]

  @@index([type])
  @@index([createdById])
  @@map("messenger_conversations")
}

model MessengerMember {
  id             String                @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime              @default(now())
  conversation   MessengerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                  @relation("MessengerMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("messenger_members")
}

model MessengerMessage {
  id             String                      @id @default(cuid())
  conversationId String
  authorId       String
  body           String                      @db.Text
  createdAt      DateTime                    @default(now())
  deletedAt      DateTime?
  conversation   MessengerConversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         User                        @relation("MessengerMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  bellEvents     MessengerMessageBellEvent[]

  @@index([conversationId, createdAt])
  @@index([authorId])
  @@map("messenger_messages")
}

/// Персональные события колокольчика о новых сообщениях мессенджера.
model MessengerMessageBellEvent {
  id          String           @id @default(cuid())
  recipientId String
  messageId   String
  kind        String /// message
  title       String
  message     String           @db.Text
  href        String
  createdAt   DateTime         @default(now())
  recipient   User             @relation("MessengerMessageBellRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  source      MessengerMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([messageId])
  @@map("messenger_message_bell_events")
}

/// Пользовательские события единого календаря админки (с уведомлениями участникам).
model CalendarCustomEvent {
  id          String                         @id @default(cuid())
  title       String
  body        String?                        @db.Text
  date        DateTime                       @db.Date
  timeFrom    String?
  timeTo      String?
  createdById String
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt
  deletedAt   DateTime?
  createdBy   User                           @relation("CalendarCustomEventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  recipients  CalendarCustomEventRecipient[]
  bellEvents  CalendarCustomEventBellEvent[]

  @@index([date])
  @@index([createdById])
  @@map("calendar_custom_events")
}

model CalendarCustomEventRecipient {
  id        String              @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime            @default(now())
  event     CalendarCustomEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User                @relation("CalendarCustomEventRecipientUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("calendar_custom_event_recipients")
}

model CalendarCustomEventBellEvent {
  id              String              @id @default(cuid())
  recipientId     String
  calendarEventId String
  kind            String /// created
  title           String
  message         String              @db.Text
  href            String
  createdAt       DateTime            @default(now())
  recipient       User                @relation("CalendarCustomEventBellRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  event           CalendarCustomEvent @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([calendarEventId])
  @@map("calendar_custom_event_bell_events")
}
