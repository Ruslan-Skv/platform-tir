  material        KnowledgeMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([materialId, userId])
  @@index([userId])
  @@map("knowledge_video_progress")
}

model KnowledgeMaterialLike {
  id         String            @id @default(cuid())
  materialId String
  userId     String
  createdAt  DateTime          @default(now())
  material   KnowledgeMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([materialId, userId])
  @@index([materialId])
  @@index([userId])
  @@map("knowledge_material_likes")
}

model KnowledgeMaterialFavorite {
