enum InstallationScheduleStatus {
  PLANNED
  DONE
  FAILED
}

/// Запись графика монтажей (одна строка дневного расписания мастера).
model InstallationScheduleEntry {
  id              String                     @id @default(cuid())
  date            DateTime                   @db.Date /// дата начала (включительно)
  dateEnd         DateTime?                  @db.Date /// дата окончания; null = один день (= date)
  timeFrom        String?
  timeTo          String?
  timeText        String? /// свободный текст времени («к 10.00»)
  direction       String /// REPAIR | WINDOWS | DOORS | CEILINGS | FURNITURE | BLINDS
  orderInfo       String?                    @db.Text
  note            String?                    @db.Text
  installerId     String?
  installerName   String? /// снимок / ручной ввод; несколько — через «, »
  /// ID монтажников из справочника (включая installerId); для «Мои монтажи» и прав
  installerIds    String[]                   @default([])
  packageId       String?
  contractId      String?
  contractNumber  String? /// снимок / ручной ввод без пакета
  workOrderKey    String? /// ключ вкладки заказ-наряда в пакете
  workOrderLabel  String? /// подпись / ручной ввод без привязки
  customerName    String?
  customerAddress String?                    @db.Text
  customerPhone   String?
  customerPhones  String[]                   @default([])
  /// Контактные лица на объекте: [{ name: string, phones: string[] }]
  contactPersons  Json                       @default("[]")
  status          InstallationScheduleStatus @default(PLANNED)
  completionNote  String?                    @db.Text
  completedAt     DateTime?
  completedById   String?
  createdById     String?
  deletedAt       DateTime?                  @map("deleted_at")
  deletedById     String?                    @map("deleted_by_id")
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  installer   InstallerMaster?                @relation(fields: [installerId], references: [id], onDelete: SetNull)
  package     ContractDocumentPackage?        @relation(fields: [packageId], references: [id], onDelete: SetNull)
  contract    Contract?                       @relation(fields: [contractId], references: [id], onDelete: SetNull)
  completedBy User?                           @relation("InstallationScheduleCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  createdBy   User?                           @relation("InstallationScheduleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deletedBy   User?                           @relation("InstallationScheduleDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  bellEvents  InstallationScheduleBellEvent[]

  @@index([date])
  @@index([dateEnd])
  @@index([direction, date])
  @@index([installerId, date])
  @@index([packageId])
  @@index([contractId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdById])
  @@map("installation_schedule_entries")
}

/// Событие графика монтажей для колокольчика (персонально автору / ответственному менеджеру пакета).
