enum KnowledgeMaterialType {
  ARTICLE
  VIDEO
  LINK
}

enum KnowledgeThumbnailDisplay {
  COVER
  CONTAIN
  NATURAL
}

enum KnowledgePlatformFeedbackType {
  SUGGESTION
  BUG
}

model KnowledgeCategory {
  id                   String                         @id @default(cuid())
  name                 String
  slug                 String                         @unique
  description          String?
  image                String?
  order                Int                            @default(0)
  deletedAt            DateTime?                      @map("deleted_at")
  deletedById          String?                        @map("deleted_by_id")
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  deletedBy            User?                          @relation("KnowledgeCategoryDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  modules              KnowledgeModule[]
  materials            KnowledgeMaterial[]
  categoryQuizAttempts KnowledgeCategoryQuizAttempt[]

  @@index([deletedAt])
  @@map("knowledge_categories")
}

model KnowledgeModule {
  id          String              @id @default(cuid())
  categoryId  String
  name        String
  slug        String
  description String?
  order       Int                 @default(0)
  deletedAt   DateTime?           @map("deleted_at")
  deletedById String?             @map("deleted_by_id")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  category    KnowledgeCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  deletedBy   User?               @relation("KnowledgeModuleDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  materials   KnowledgeMaterial[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([deletedAt])
  @@map("knowledge_modules")
}

model KnowledgeMaterial {
  id                         String                             @id @default(cuid())
  categoryId                 String
  moduleId                   String?
  type                       KnowledgeMaterialType
  title                      String
  slug                       String                             @unique
  excerpt                    String?
  content                    String?                            @db.Text
  readingTimeMinutes         Int?
  tutorRecommendation        String?                            @db.Text
  managerPracticalAssignment String?                            @db.Text
  videoUrl                   String?
  externalUrl                String?
  thumbnailUrl               String?
  thumbnailDisplay           KnowledgeThumbnailDisplay          @default(COVER)
  sortOrder                  Int                                @default(0)
  isPinned                   Boolean                            @default(false)
  status                     PageStatus                         @default(DRAFT)
  publishedAt                DateTime?
  deletedAt                  DateTime?                          @map("deleted_at")
  deletedById                String?                            @map("deleted_by_id")
  authorId                   String
  createdAt                  DateTime                           @default(now())
  updatedAt                  DateTime                           @updatedAt
  category                   KnowledgeCategory                  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  module                     KnowledgeModule?                   @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  author                     User                               @relation(fields: [authorId], references: [id])
  deletedBy                  User?                              @relation("KnowledgeMaterialDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  attachments                KnowledgeMaterialAttachment[]
  targetAudiences            KnowledgeMaterialTargetAudience[]
  videoProgress              KnowledgeVideoProgress[]
  quiz                       KnowledgeMaterialQuiz?
  quizAttempts               KnowledgeQuizAttempt[]
  likes                      KnowledgeMaterialLike[]
  favorites                  KnowledgeMaterialFavorite[]
  studyCompletions           KnowledgeMaterialStudyCompletion[]
  comments                   KnowledgeMaterialComment[]

  @@index([categoryId])
  @@index([moduleId])
  @@index([type])
  @@index([status])
  @@index([isPinned])
  @@index([deletedAt])
  @@map("knowledge_materials")
}

model KnowledgeTargetAudience {
