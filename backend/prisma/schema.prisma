model Customer {
  id              String            @id @default(cuid())
  email           String?           @unique
  phone           String?
  /// Все номера телефонов (первый дублируется в phone для поиска и старых интеграций)
  phones          String[]          @default([]) @map("phones")
  firstName       String
  lastName        String?
  company         String?
  position        String?
  /// PERSON | COMPANY | ENTREPRENEUR — вид заказчика в CRM
  entityType      String?           @map("entity_type") @db.VarChar(32)
  /// Реквизиты в формате блока «Заказчик» пакета «Ремонт» (JSON)
  extendedProfile Json?             @map("extended_profile")
  source          LeadSource        @default(WEBSITE)
  status          CustomerStatus    @default(LEAD)
  stage           DealStage         @default(NEW)
  dealValue       Decimal?          @db.Decimal(12, 2)
  notes           String?
  tags            String[]
  managerId       String?
  createdById     String?           @map("created_by_id")
  updatedById     String?           @map("updated_by_id")
  isActive        Boolean           @default(true)
  lastContactAt   DateTime?
  nextFollowUp    DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  /// Мягкое удаление: карточка в корзине, не показывается в справочнике
  deletedAt       DateTime?         @map("deleted_at")
  manager         User?             @relation("ManagerCustomers", fields: [managerId], references: [id])
  createdBy       User?             @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?             @relation("CustomerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deals           Deal[]
  interactions    Interaction[]
  tasks           Task[]
  measurements    Measurement[]
  contracts       Contract[]
  history         CustomerHistory[]

  @@index([deletedAt])
  @@map("customers")
}

model CustomerHistory {
  id            String   @id @default(cuid())
  customerId    String   @map("customer_id")
  snapshot      Json
  changedFields String[] @default([]) @map("changed_fields")
  action        String
  changedById   String   @map("changed_by_id")
  changedAt     DateTime @default(now()) @map("changed_at")

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  changedBy User     @relation("CustomerHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([changedAt])
  @@map("customer_history")
}

model Interaction {
