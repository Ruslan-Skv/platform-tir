/// Категория сверки прайс-листа поставщика
enum SupplierPriceListCategory {
  TRIM
  INTERIOR_DOOR
  STEEL_DOOR
  HARDWARE
  ARCH
  ACCORDION
}

/// Снимок загруженного прайс-листа поставщика
model SupplierPriceListSnapshot {
  id             String                    @id @default(cuid())
  supplierId     String
  category       SupplierPriceListCategory @default(TRIM)
  fileName       String
  storedFileName String?
  priceListDate  String?
  parserCode     String                    @default("STROYKOM_MK")
  sheetName      String                    @default("Межкомнатные двери с фото")
  rowCount       Int                       @default(0)
  uploadedById   String?
  createdAt      DateTime                  @default(now())

  supplier   Supplier               @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  uploadedBy User?                  @relation("SupplierPriceListUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  rows       SupplierPriceListRow[]

  @@index([supplierId])
  @@index([supplierId, category])
  @@index([createdAt])
  @@map("supplier_price_list_snapshots")
}

/// Строка из прайс-листа
model SupplierPriceListRow {
  id          String  @id @default(cuid())
  snapshotId  String
  rowKey      String
  blockTitle  String
  color       String
  itemName    String
  size        String?
  material    String?
  variantNote String?
  priceRrc    Decimal @db.Decimal(10, 2)

  snapshot SupplierPriceListSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, rowKey])
  @@index([snapshotId])
  @@map("supplier_price_list_rows")
}

/// Привязка строки прайса к позиции справочника комплектующих
model SupplierPriceListRowMapping {
  id            String   @id @default(cuid())
  supplierId    String
  rowKey        String
  catalogItemId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  supplier    Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  catalogItem ComponentCatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([supplierId, rowKey])
  @@index([catalogItemId])
  @@map("supplier_price_list_row_mappings")
}

model SupplierSettlementRow {
  id         String   @id @default(cuid())
  supplierId String
  date       String? // YYYY-MM-DD
  invoice    String?
  amount     Decimal? @db.Decimal(12, 2)
  payment    Decimal? @db.Decimal(12, 2)
  note       String?  @db.Text
  sortOrder  Int      @default(0)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@map("supplier_settlement_rows")
}

model SupplierSettlementHistory {
  id            String   @id @default(cuid())
  supplierId    String
  snapshot      Json // Массив строк { rows: [...] }
  changedFields String[] @default([])
  action        String // UPDATE | ROLLBACK
  changedById   String
  changedAt     DateTime @default(now())

  supplier  Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  changedBy User     @relation("SupplierSettlementHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([supplierId])
  @@index([changedAt])
  @@map("supplier_settlement_history")
}

model ProductSupplier {
  id                         String    @id @default(cuid())
  productId                  String
  supplierId                 String
  supplierSku                String
  supplierPrice              Decimal   @db.Decimal(10, 2)
  supplierStock              Int       @default(0)
  supplierProductUrl         String? // Ссылка на товар у поставщика
  supplierPriceChangedAt     DateTime? // Пометка: цена поставщика изменилась при последней синхронизации
  supplierPriceSyncError     String? // Текст ошибки при последней попытке получить цену
  supplierPriceSyncErrorCode String? // Код ошибки (PRODUCT_NOT_FOUND, TIMEOUT, …)
  supplierPriceSyncErrorAt   DateTime? // Когда зафиксирована ошибка
  supplierCatalogNewAt       DateTime? // Пометка: добавлен последним импортом каталога поставщика
  supplierCatalogMissingAt   DateTime? // Пометка: нет в разделе поставщика при последнем импорте
  isMainSupplier             Boolean   @default(false)
  lastSyncAt                 DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  product                    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier                   Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

model SupplierSyncLog {
