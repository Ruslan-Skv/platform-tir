generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserNotificationSettings {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  notifyOnSupportChatReply Boolean  @default(true)
  mobileCatalogColumns     Int? // 1 или 2 — кол-во карточек в строке на мобильном (null = по умолчанию сайта)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_settings")
}

model UserNotification {
  id        String   @id @default(cuid())
  userId    String
  type      String // support_chat | order_status | system
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_notifications")
}

model User {
  id                                      String                                   @id @default(cuid())
  email                                   String                                   @unique
  password                                String
  firstName                               String?
  lastName                                String?
  role                                    UserRole                                 @default(USER)
  isActive                                Boolean                                  @default(true)
  isGuest                                 Boolean                                  @default(false) // Для заказов от менеджера: гость до регистрации
  yandexId                                String?                                  @unique // ID аккаунта Яндекс для OAuth
  createdAt                               DateTime                                 @default(now())
  updatedAt                               DateTime                                 @updatedAt
  avatar                                  String?
  phone                                   String?
  notificationSettings                    UserNotificationSettings?
  notificationHistory                     UserNotification[]
  adminNotificationOverride               UserAdminNotificationOverride?
  addresses                               Address[]
  blogPosts                               BlogPost[]
  knowledgeMaterials                      KnowledgeMaterial[]
  knowledgeMaterialsDeleted               KnowledgeMaterial[]                      @relation("KnowledgeMaterialDeletedBy")
  knowledgeCategoriesDeleted              KnowledgeCategory[]                      @relation("KnowledgeCategoryDeletedBy")
  knowledgeModulesDeleted                 KnowledgeModule[]                        @relation("KnowledgeModuleDeletedBy")
  knowledgeVideoProgress                  KnowledgeVideoProgress[]
  knowledgeMaterialLikes                  KnowledgeMaterialLike[]
  knowledgeMaterialFavorites              KnowledgeMaterialFavorite[]
  knowledgeMaterialStudyCompletions       KnowledgeMaterialStudyCompletion[]
  knowledgeMaterialComments               KnowledgeMaterialComment[]
  knowledgePlatformFeedback               KnowledgePlatformFeedback[]
  adminPushSubscriptions                  AdminPushSubscription[]
  knowledgeQuizAttempts                   KnowledgeQuizAttempt[]
  cartItems                               CartItem[]
  cartServiceItems                        CartServiceItem[]
  comments                                Comment[]
  assignedCustomers                       Customer[]                               @relation("ManagerCustomers")
  customersCreated                        Customer[]                               @relation("CustomerCreatedBy")
  customersUpdated                        Customer[]                               @relation("CustomerUpdatedBy")
  interactions                            Interaction[]
  orders                                  Order[]
  ordersCreatedForCustomers               Order[]                                  @relation("OrdersCreatedByManager")
  ordersProcessedByManagers               Order[]                                  @relation("OrdersProcessedByManager")
  salesMetrics                            SalesMetric[]
  tasks                                   Task[]                                   @relation("AssignedTasks")
  createdTasks                            Task[]                                   @relation("CreatedTasks")
  wishlist                                WishlistItem[]
  compareItems                            CompareItem[]
  supportConversations                    SupportConversation[]                    @relation("SupportUser")
  assignedSupportConversations            SupportConversation[]                    @relation("SupportAgent")
  supportMessages                         SupportMessage[]
  managedMeasurements                     Measurement[]                            @relation("MeasurementManager")
  surveyedMeasurements                    Measurement[]                            @relation("MeasurementSurveyor")
  managedContracts                        Contract[]                               @relation("ContractManager")
  surveyedContracts                       Contract[]                               @relation("ContractSurveyor")
  contractPayments                        ContractPayment[]
  measurementHistory                      MeasurementHistory[]                     @relation("MeasurementHistoryChangedBy")
  contractHistory                         ContractHistory[]                        @relation("ContractHistoryChangedBy")
  complexObjectHistory                    ComplexObjectHistory[]                   @relation("ComplexObjectHistoryChangedBy")
  officeHistory                           OfficeHistory[]                          @relation("OfficeHistoryChangedBy")
  supplierSettlementHistory               SupplierSettlementHistory[]              @relation("SupplierSettlementHistoryChangedBy")
  taskHistory                             TaskHistory[]                            @relation("TaskHistoryChangedBy")
  customerHistory                         CustomerHistory[]                        @relation("CustomerHistoryChangedBy")
  managedComplexObjects                   ComplexObject[]                          @relation("ComplexObjectManager")
  adminResourcePermissions                AdminResourcePermission[]
  officeOtherExpensesCreated              OfficeOtherExpense[]
  officeIncassationsCreated               OfficeIncassation[]
  orderEventsAsActor                      OrderEvent[]                             @relation("OrderEventActor")
  serviceOrders                           ServiceOrder[]                           @relation
  serviceOrdersCreated                    ServiceOrder[]                           @relation("ServiceOrdersCreatedByManager")
  passwordResetTokens                     PasswordResetToken[]
  refreshSessions                         UserRefreshToken[]
  productsCreated                         Product[]                                @relation("ProductCreatedBy")
  productsUpdated                         Product[]                                @relation("ProductUpdatedBy")
  categoriesCreated                       Category[]                               @relation("CategoryCreatedBy")
  contractDocumentPackagesCreated         ContractDocumentPackage[]                @relation("ContractDocumentPackagesCreated")
  contractDocumentPackagesDeleted         ContractDocumentPackage[]                @relation("ContractDocumentPackagesDeleted")
  contractDocumentPackagePaymentsRecorded ContractDocumentPackagePayment[]         @relation("ContractDocumentPackagePaymentRecordedBy")
  contractDocumentPaymentInvoicesIssued   ContractDocumentPaymentInvoice[]         @relation("ContractDocumentPaymentInvoiceIssuedBy")
  contractDocumentGlobalTemplatesUpdated  ContractDocumentGlobalTemplate[]         @relation("GlobalContractTemplateUpdatedBy")
  contractDocumentRepairSettingsUpdated   ContractDocumentRepairSettings[]         @relation("ContractDocumentRepairSettingsUpdatedBy")
  contractDocumentPackageVersionsSaved    ContractDocumentPackageVersion[]         @relation("ContractDocumentPackageVersionSavedBy")
  contractDocumentEstimatePresetsHistory  ContractDocumentEstimatePresetsHistory[] @relation("ContractDocumentEstimatePresetsHistoryChangedBy")
  salesCandidatesCreated                  SalesCandidate[]                         @relation("SalesCandidateCreatedBy")
  salesCandidateAsTrainee                 SalesCandidate?                          @relation("SalesCandidateTrainee")
  recruitmentCampaignsCreated             RecruitmentCampaign[]                    @relation("RecruitmentCampaignCreatedBy")

  @@map("users")
}

/// Токен для восстановления пароля. Срок действия 1 час.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Долгоживущая сессия: в БД хранится только SHA-256 от opaque refresh-токена (как у reset-ссылок).
model UserRefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_refresh_tokens")
}

model AdminResourcePermission {
  id         String   @id @default(cuid())
  resourceId String
  userId     String
  permission String // VIEW | PARTICIPATE | EDIT | DENIED
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, userId])
  @@index([resourceId])
  @@index([userId])
  @@map("admin_resource_permissions")
}

/// Права доступа к ресурсам админки по ролям (влияют на всех пользователей с этой ролью).
model AdminResourceRolePermission {
  id         String   @id @default(cuid())
  resourceId String
  role       String // SUPER_ADMIN, ADMIN, CONTENT_MANAGER и т.д.
  permission String // VIEW | PARTICIPATE | EDIT | DENIED
  createdAt  DateTime @default(now())

  @@unique([resourceId, role])
  @@index([resourceId])
  @@index([role])
  @@map("admin_resource_role_permissions")
}

model SupportConversation {
  id           String             @id @default(cuid())
  userId       String
  assignedToId String?
  status       ConversationStatus @default(OPEN)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  user         User               @relation("SupportUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo   User?              @relation("SupportAgent", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     SupportMessage[]

  @@map("support_conversations")
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  senderId       String
  content        String              @db.Text
  createdAt      DateTime            @default(now())
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("support_messages")
}

model HomeDirectionImage {
  id        String   @id @default(cuid())
  slug      String   @unique
  imageUrl  String
  updatedAt DateTime @updatedAt

  @@map("home_direction_images")
}

model HeroBlock {
  id            String   @id @default("main")
  titleMain     String   @default("Создаем интерьеры мечты")
  titleAccent   String   @default("в Мурманске")
  subtitle      String   @default("Мебель на заказ, ремонт под ключ, двери входные и межкомнатные, натяжные потолки, жалюзи, мягкая мебель, кровати, матрасы .....") @db.Text
  slideShowMode String   @default("auto") // auto | manual | static
  slideGap      Int      @default(16) // зазор между фотографиями в слайдере (px)
  updatedAt     DateTime @updatedAt

  @@map("hero_block")
}

model HeroSlide {
  id        String   @id @default(cuid())
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("hero_slides")
}

model HeroFeature {
  id        String   @id @default(cuid())
  icon      String
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("hero_features")
}

model AdvantagesBlock {
  id        String   @id @default("main")
  title     String   @default("Почему выбирают нас")
  subtitle  String   @default("Мы делаем качество доступным")
  updatedAt DateTime @updatedAt

  @@map("advantages_block")
}

model AdvantageItem {
  id          String   @id @default(cuid())
  icon        String
  title       String
  description String   @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("advantage_items")
}

model ServicesBlock {
  id        String   @id @default("main")
  title     String   @default("Комплексные решения")
  subtitle  String   @default("Полный цикл услуг для вашего комфорта")
  updatedAt DateTime @updatedAt

  @@map("services_block")
}

model FeaturedProductsBlock {
  id             String   @id @default("main")
  title          String   @default("Популярные товары")
  subtitle       String   @default("Товары, которые выбирают наши клиенты")
  limit          Int      @default(8)
  primaryFilter  String   @default("featured") // featured | new | featured_or_new | any
  secondaryOrder String   @default("sort_order") // sort_order | created_desc
  updatedAt      DateTime @updatedAt

  @@map("featured_products_block")
}

model HomePageSectionsBlock {
  id                      String   @id @default("main")
  heroVisible             Boolean  @default(true)
  directionsVisible       Boolean  @default(true)
  advantagesVisible       Boolean  @default(true)
  servicesVisible         Boolean  @default(true)
  featuredProductsVisible Boolean  @default(true)
  contactFormVisible      Boolean  @default(true)
  updatedAt               DateTime @updatedAt

  @@map("home_page_sections_block")
}

model ContactFormBlock {
  id                String   @id @default("main")
  title             String   @default("Готовы начать проект?")
  subtitle          String   @default("Оставьте заявку и получите бесплатную консультацию специалиста") @db.Text
  backgroundImage   String? // URL или путь к фоновой картинке
  backgroundOpacity Float? // Прозрачность фона 0–1 (null = 0.5)
  updatedAt         DateTime @updatedAt

  @@map("contact_form_block")
}

model DirectorMessageBlock {
  id             String   @id @default("main")
  directorEmail  String? // Email директора для формы «Письмо директору» (если пусто — письма не отправляются)
  telegramChatId String? // ID чата Telegram для уведомлений (если пусто — уведомления в Telegram не отправляются)
  updatedAt      DateTime @updatedAt

  @@map("director_message_block")
}

/// Настройки формы «Записаться на замер»: email и Telegram для уведомлений при подаче заявки
model MeasurementFormBlock {
  id             String   @id @default("main")
  recipientEmail String? // Email для получения уведомлений о новых заявках (если пусто — только сохранение в БД)
  telegramChatId String? // ID чата Telegram для уведомлений
  updatedAt      DateTime @updatedAt

  @@map("measurement_form_block")
}

/// Настройки формы «Заказать звонок»: email и Telegram для уведомлений при подаче заявки
model CallbackFormBlock {
  id             String   @id @default("main")
  recipientEmail String? // Email для получения уведомлений (если пусто — только сохранение в БД)
  telegramChatId String? // ID чата Telegram для уведомлений
  updatedAt      DateTime @updatedAt

  @@map("callback_form_block")
}

/// Настройки формы «Рассчитать стоимость» / «Отправить заявку»: email, Telegram и список позиций
model QuoteFormBlock {
  id                 String   @id @default("main")
  recipientEmail     String? // Email для получения уведомлений (если пусто — только сохранение в БД)
  telegramChatId     String? // ID чата Telegram для уведомлений
  serviceTypeOptions Json? // Массив строк — виды работ/товаров для выбора (настраивается в админке)
  updatedAt          DateTime @updatedAt

  @@map("quote_form_block")
}

/// Квиз-лендинг (мебель, ремонт и др. направления)
model QuizLanding {
  id                   String           @id @default(cuid())
  slug                 String           @unique
  direction            String           @default("furniture") // furniture | repair | windows | ...
  title                String
  domain               String?          @unique
  isActive             Boolean          @default(true)
  headline             String?
  subheadline          String?          @db.Text
  promoText            String?
  logoUrl              String?
  primaryColor         String           @default("#c9a227")
  theme                Json? // цвета, шрифты, фон — см. QuizTheme
  displayPhone         String?
  city                 String?
  successTitle         String?
  successText          String?          @db.Text
  catalogFileUrl       String?
  privacyPolicyUrl     String?
  privacyPolicyTitle   String?
  privacyPolicyContent String?          @db.Text
  consentText          String?          @db.Text
  consentLinkText      String?
  notifyEmails         Json? // string[]
  notifyTelegramIds    Json? // string[]
  notifyPhones         Json? // string[] — для SMS в будущем; дублируется в тексте уведомления
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  steps                QuizStep[]
  submissions          QuizSubmission[]

  @@map("quiz_landings")
}

model QuizStep {
  id          String      @id @default(cuid())
  quizId      String
  key         String
  sortOrder   Int
  type        String // choice | text | contact
  title       String
  subtitle    String?
  placeholder String?
  required    Boolean     @default(true)
  options     Json? // { value, label, imageUrl? }[]
  showWhen    Json? // { branchKey, values } | null — ветвление
  quiz        QuizLanding @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, key])
  @@map("quiz_steps")
}

model QuizSubmission {
  id            String      @id @default(cuid())
  quizId        String
  name          String
  phone         String
  answers       Json
  furnitureType String?
  status        String      @default("new") // new | contacted | in_progress | completed | cancelled
  managerNote   String?     @db.Text
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  referrer      String?
  landingUrl    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  quiz          QuizLanding @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, createdAt])
  @@index([quizId, status])
  @@map("quiz_submissions")
}

model Partner {
  id              String    @id @default(cuid())
  name            String // Название партнёра
  logoUrl         String? // URL логотипа (для карточек товаров)
  showLogoOnCards Boolean   @default(true) // Показывать логотип на карточках товаров
  tooltipText     String? // Текст всплывающей подсказки при наведении на логотип (если пусто — "Товар Партнёра : название")
  showTooltip     Boolean   @default(true) // Показывать всплывающую подсказку при наведении на логотип
  website         String?
  email           String?
  phone           String[]  @default([])
  description     String?   @db.Text
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[]

  @@map("partners")
}

model PartnerProductsBlock {
  id                     String   @id @default("main")
  partnerLogoUrl         String? // URL логотипа партнёра по умолчанию (в кружке на карточках)
  showPartnerIconOnCards Boolean  @default(true) // Показывать иконку партнёра на карточках товаров
  updatedAt              DateTime @updatedAt

  @@map("partner_products_block")
}

model FooterBlock {
  id                   String   @id @default("main")
  workingHoursWeekdays String   @default("пн-пт: 11-19")
  workingHoursSaturday String   @default("сб: 12-16")
  workingHoursSunday   String   @default("вс: выходной")
  phone                String   @default("8 (8152) 60-12-70")
  email                String   @default("skvirya@mail.ru")
  developer            String   @default("ИП Сквиря Р.В.")
  copyrightCompanyName String   @default("Территория интерьерных решений")
  vkHref               String   @default("https://vk.com/pskpobeda")
  vkIcon               String   @default("/images/icons-vk.png")
  updatedAt            DateTime @updatedAt

  @@map("footer_block")
}

model FooterSection {
  id        String              @id @default(cuid())
  title     String
  sortOrder Int                 @default(0)
  links     FooterSectionLink[]

  @@map("footer_sections")
}

model FooterSectionLink {
  id        String        @id @default(cuid())
  sectionId String
  name      String
  href      String
  sortOrder Int           @default(0)
  section   FooterSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("footer_section_links")
}

model NavigationItem {
  id            String                   @id @default(cuid())
  name          String
  href          String                   @default("#")
  sortOrder     Int                      @default(0)
  hasDropdown   Boolean                  @default(false)
  isActive      Boolean                  @default(true)
  dropdownItems NavigationDropdownItem[]

  @@map("navigation_items")
}

model NavigationDropdownItem {
  id        String                      @id @default(cuid())
  navItemId String
  name      String
  href      String                      @default("#")
  sortOrder Int                         @default(0)
  icon      String? // имя иконки heroicons или URL
  navItem   NavigationItem              @relation(fields: [navItemId], references: [id], onDelete: Cascade)
  submenu   NavigationDropdownSubItem[]

  @@map("navigation_dropdown_items")
}

model NavigationDropdownSubItem {
  id           String                 @id @default(cuid())
  dropdownId   String
  name         String
  href         String                 @default("#")
  sortOrder    Int                    @default(0)
  dropdownItem NavigationDropdownItem @relation(fields: [dropdownId], references: [id], onDelete: Cascade)

  @@map("navigation_dropdown_sub_items")
}

model ServiceItem {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  features    String[]
  price       String
  imageUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("service_items")
}

// --- Ремонт квартир (виды работ с ценами) ---
model ServiceCatalogBlock {
  id                 String   @id @default("main")
  title              String   @default("Ремонт квартир")
  showPricesInPublic Boolean  @default(true) // Показывать стоимость в публичной части
  updatedAt          DateTime @updatedAt

  @@map("service_catalog_block")
}

model ServiceCatalogCategory {
  id                        String                   @id @default(cuid())
  name                      String
  slug                      String                   @unique
  description               String?                  @db.Text
  icon                      String? // Имя иконки heroicons (PaintBrush, Bolt и т.д.)
  image                     String? // URL или base64 — при наличии показывается вместо иконки
  /// Фон карточки категории на странице «Ремонт квартир» (URL или data URL)
  cardBackgroundImage       String?
  /// Публичная плитка категории без заливки (#fff / тёмный фон) — виден фон страницы; при фоновой картинке слой затемнения слабее
  cardBackgroundTransparent Boolean                  @default(false)
  /// Наценка на все виды работ в этой категории, % к базовой цене позиции (может быть отрицательной). 0 — наследовать у родителя; ненулевое — своя наценка. Публичка показывает только итог.
  priceMarkupPercent        Decimal                  @default(0) @db.Decimal(10, 2)
  showPricesInPublic        Boolean                  @default(true) // Показывать стоимость в публичной части
  sortOrder                 Int                      @default(0)
  isActive                  Boolean                  @default(true)
  parentId                  String?
  parent                    ServiceCatalogCategory?  @relation("ServiceCatalogCategoryChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children                  ServiceCatalogCategory[] @relation("ServiceCatalogCategoryChildren")
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  items                     ServiceCatalogItem[]
  cartServiceItems          CartServiceItem[]

  @@index([parentId])
  @@map("service_catalog_categories")
}

model ServiceCatalogItem {
  id                String                 @id @default(cuid())
  categoryId        String
  name              String // Вид работ (например "Шпатлёвка стен")
  description       String?                @db.Text
  price             Decimal                @db.Decimal(12, 2) // Стоимость за единицу
  unit              String                 @default("м²") // Единица измерения: м², шт, п.м. и т.д.
  sortOrder         Int                    @default(0)
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  category          ServiceCatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  serviceOrderItems ServiceOrderItem[]
  orderServiceItems OrderServiceItem[]

  @@index([categoryId])
  @@map("service_catalog_items")
}

/// Заказ на услуги (оформляет менеджер для клиента).
model ServiceOrder {
  id                 String             @id @default(cuid())
  orderNumber        String             @unique
  userId             String // Покупатель (существующий или гость)
  createdByManagerId String? // Менеджер, оформивший заказ
  customerEmail      String // Email получателя
  customerFirstName  String?
  customerLastName   String?
  customerPhone      String? // Телефон покупателя
  total              Decimal            @db.Decimal(12, 2)
  status             ServiceOrderStatus @default(PENDING)
  customerNotes      String?            @db.Text
  adminNotes         String?            @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdByManager   User?              @relation("ServiceOrdersCreatedByManager", fields: [createdByManagerId], references: [id], onDelete: SetNull)
  items              ServiceOrderItem[]

  @@map("service_orders")
}

model ServiceOrderItem {
  id                   String             @id @default(cuid())
  serviceOrderId       String
  serviceCatalogItemId String
  name                 String // Название вида работ (денормализация)
  categoryName         String // Название категории (денормализация)
  unit                 String // Ед. изм.
  quantity             Decimal            @db.Decimal(12, 2)
  price                Decimal            @db.Decimal(12, 2)
  amount               Decimal            @db.Decimal(12, 2)
  createdAt            DateTime           @default(now())
  serviceOrder         ServiceOrder       @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  serviceCatalogItem   ServiceCatalogItem @relation(fields: [serviceCatalogItemId], references: [id], onDelete: Restrict)

  @@index([serviceOrderId])
