/// Публичный каталог: вид элемента в блоке фильтров (атрибут / наличие / производитель).
enum CatalogFilterItemKind {
  ATTRIBUTE
  STOCK
  MANUFACTURER
}

/// Порядок значений внутри фильтра по атрибуту (витрина каталога).
enum CatalogFilterOptionsSort {
  /// По убыванию извлечённого числа («100 мм» выше «40 мм»); без числа — в конце, по алфавиту.
  NUMERIC_DESC
  /// По алфавиту (как раньше по умолчанию).
  TEXT_ASC
  /// Явный список значений (совпадение строки с карточки товара); остальные — после, по NUMERIC_DESC.
  MANUAL
}

/// Настройки блока фильтров категории (админка → Настройки → Блок фильтров).
model CatalogFilterBlock {
  id                 String                   @id @default(cuid())
  name               String                   @default("")
  categoryId         String                   @unique
  includeDescendants Boolean                  @default(true)
  sortOrder          Int                      @default(0)
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  category           Category                 @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  items              CatalogFilterBlockItem[]

  @@map("catalog_filter_blocks")
}

model CatalogFilterBlockItem {
  id                String                   @id @default(cuid())
  blockId           String
  kind              CatalogFilterItemKind
  attributeId       String?
  labelOverride     String?
  sortOrder         Int                      @default(0)
  /// Только для kind=ATTRIBUTE; для STOCK/MANUFACTURER не используется (оставлено значение по умолчанию).
  optionsSort       CatalogFilterOptionsSort @default(NUMERIC_DESC)
  /// Список значений в нужном порядке (только при optionsSort=MANUAL).
  manualOptionOrder Json?
  block             CatalogFilterBlock       @relation(fields: [blockId], references: [id], onDelete: Cascade)
  attribute         Attribute?               @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@map("catalog_filter_block_items")
}

model Category {
  id                        String                     @id @default(cuid())
  name                      String
  slug                      String                     @unique
  description               String?
  image                     String?
  parentId                  String?
  order                     Int                        @default(0)
  isActive                  Boolean                    @default(true)
  /// Если false — размеры в карточке товара не обязательны (например, фурнитура).
  sizesRequired             Boolean                    @default(true)
  /// Показывать дочерние категории чекбоксами в блоке фильтров на странице этой категории.
  showChildCategoryFilters  Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  icon                      String?
  createdById               String?
  parent                    Category?                  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children                  Category[]                 @relation("CategoryTree")
  attributes                CategoryAttribute[]
  products                  Product[]
  componentCatalogGroups    ComponentCatalogGroup[]
  componentCatalogSeries    ComponentCatalogSeries[]
  catalogFilterBlock        CatalogFilterBlock?
  catalogHubPreviewSections CatalogHubPreviewSection[]
  createdBy                 User?                      @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("categories")
}

model CategoryAttribute {
  id          String    @id @default(cuid())
  categoryId  String
  attributeId String
  isRequired  Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, attributeId])
  @@map("category_attributes")
}

model Product {
  id                     String                         @id @default(cuid())
  name                   String
  slug                   String                         @unique
  description            String?
  sku                    String?                        @unique
  price                  Decimal                        @db.Decimal(10, 2)
  comparePrice           Decimal?                       @db.Decimal(10, 2)
  stock                  Int                            @default(0)
  /// При нулевом остатке: витрина «Под заказ» вместо «Товар закончился». Если остаток больше нуля — всегда «В наличии».
  onOrder                Boolean                        @default(false)
  isActive               Boolean                        @default(true)
  isFeatured             Boolean                        @default(false)
  isNew                  Boolean                        @default(false)
  isPartnerProduct       Boolean                        @default(false)
  partnerId              String?
  sortOrder              Int                            @default(0)
  categoryId             String
  images                 String[]
  videoUrl               String? // URL видеоролика о товаре (YouTube, Vimeo или свой хостинг)
  attributes             Json?
  seoTitle               String?
  seoDescription         String?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  createdById            String? // Кто создал карточку товара
  updatedById            String? // Кто последний изменил
  barcode                String?
  costPrice              Decimal?                       @db.Decimal(10, 2)
  height                 Decimal?                       @db.Decimal(8, 2)
  length                 Decimal?                       @db.Decimal(8, 2)
  manufacturerId         String?
  coatingMaterialId      String?
  canvasTypeId           String?
  doorThicknessId        String?
  weatherstripId         String?
  minStock               Int                            @default(0)
  seoKeywords            String[]
  shortDescription       String?
  weight                 Decimal?                       @db.Decimal(8, 3)
  width                  Decimal?                       @db.Decimal(8, 2)
  sizes                  String[]
  openingSide            String[]
  cartItems              CartItem[]
  orderItems             OrderItem[]
  orderItemsReplacedFrom OrderItem[]                    @relation("OrderItemReplacedFrom")
  suppliers              ProductSupplier[]
  category               Category                       @relation(fields: [categoryId], references: [id])
  manufacturer           Manufacturer?                  @relation(fields: [manufacturerId], references: [id])
  coatingMaterial        CoatingMaterial?               @relation(fields: [coatingMaterialId], references: [id])
  canvasType             CanvasType?                    @relation(fields: [canvasTypeId], references: [id])
  doorThickness          DoorThickness?                 @relation(fields: [doorThicknessId], references: [id])
  weatherstrip           Weatherstrip?                  @relation(fields: [weatherstripId], references: [id])
  partner                Partner?                       @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  createdBy              User?                          @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy              User?                          @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  reviews                Review[]
  wishlist               WishlistItem[]
  compareItems           CompareItem[]
  components             ProductComponent[]
  cardVariants           ProductCardVariant[]
  cardBadgeSelections    ProductCardBadgeOnProduct[]
  catalogHubPreviewPicks CatalogHubPreviewProductPick[]

  @@index([categoryId, isActive, sortOrder])
  @@map("products")
}

/// Справочник бэйджей карточки товара (слева от фото — JPG из настроек каталога).
model ProductCardBadgeDefinition {
  id          String                      @id @default(cuid())
  key         String                      @unique
  label       String
  description String?                     @db.Text
  imageUrl    String?
  sortOrder   Int                         @default(0)
  products    ProductCardBadgeOnProduct[]

  @@map("product_card_badge_definitions")
}

/// Выбранные для товара бэйджи (макс. 5 на товар), порядок = sortOrder.
model ProductCardBadgeOnProduct {
  id        String                     @id @default(cuid())
  productId String
  badgeId   String
  sortOrder Int                        @default(0)
  product   Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  badge     ProductCardBadgeDefinition @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([productId, badgeId])
  @@index([productId])
  @@map("product_card_badge_on_products")
}

/// Схожие товары в одной карточке (до 5): отличаются ценой, размером, фото, наименованием, цветом, доп. опцией (как на Wildberries/Озон).
model ProductCardVariant {
  id          String     @id @default(cuid())
  productId   String
  name        String // Наименование варианта
  price       Decimal    @db.Decimal(10, 2)
  image       String? // URL или base64
  size        String? // Размер
  color       String? // Цвет
  extraOption String? // Доп. опция
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]

  @@map("product_card_variants")
}

/// Вид комплектующей — справочник (можно добавлять из админки)
model ComponentCatalogKind {
  id           String                 @id @default(cuid())
  /// Машинный код, напр. STOIKA_KOROBKI — для расчёта комплекта
  code         String                 @unique
  name         String
  slug         String                 @unique
  kitQuantity  Float?
  quantityStep Float                  @default(1)
  sortOrder    Int                    @default(0)
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  items        ComponentCatalogItem[]

  @@map("component_catalog_kinds")
}

/// Группа моделей дверей (серия), к которой относятся подгруппы комплектующих
model ComponentCatalogSeries {
  id          String                  @id @default(cuid())
  name        String
  description String?
  categoryId  String?
  supplierId  String?
  slug        String                  @unique
  isActive    Boolean                 @default(true)
  sortOrder   Int                     @default(0)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  category    Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier    Supplier?               @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  subgroups   ComponentCatalogGroup[]

  @@index([supplierId])
  @@map("component_catalog_series")
}

/// Справочник комплектующих — единая цена для всех товаров
model ComponentCatalogItem {
  id                String                        @id @default(cuid())
  kindId            String
  name              String // Название: Наличник, Добор, Стойка коробки
  size              String? // Размер: 70мм, 2000x800
  color             String? // Цвет
  material          String? // Материал изготовления
  price             Decimal                       @db.Decimal(10, 2)
  slug              String                        @unique
  image             String?
  stock             Int                           @default(0)
  isActive          Boolean                       @default(true)
  sortOrder         Int                           @default(0)
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  kindRef           ComponentCatalogKind          @relation(fields: [kindId], references: [id], onDelete: Restrict)
  productComponents ProductComponent[]
  groupItems        ComponentCatalogGroupItem[]
  priceListMappings SupplierPriceListRowMapping[]

  @@index([kindId])
  @@map("component_catalog_items")
}

/// Подгруппа комплектующих (цвет/вариант): стойка, наличник, добор одного цвета
model ComponentCatalogGroup {
  id         String                      @id @default(cuid())
  seriesId   String
  name       String
  /// Доп. описание подгруппы (оттенок, тип погонажа)
  series     String?
  categoryId String?
  slug       String
  isActive   Boolean                     @default(true)
  sortOrder  Int                         @default(0)
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt
  seriesRef  ComponentCatalogSeries      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  category   Category?                   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items      ComponentCatalogGroupItem[]

  @@unique([seriesId, slug])
  @@index([seriesId])
  @@map("component_catalog_groups")
}

model ComponentCatalogGroupItem {
  id            String                @id @default(cuid())
  groupId       String
  catalogItemId String
  sortOrder     Int                   @default(0)
  group         ComponentCatalogGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  catalogItem   ComponentCatalogItem  @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([groupId, catalogItemId])
  @@map("component_catalog_group_items")
}

model ProductComponent {
  id            String                @id @default(cuid())
  productId     String
  catalogItemId String?
  /// Legacy-поля (для строк без справочника или снимок при создании)
  name          String // Наименование: коробка, наличник, добор, притворная планка
  type          String // Конкретный тип комплектующей (размер)
  price         Decimal               @db.Decimal(10, 2) // Стоимость за 1 шт.
  image         String? // Иконка/изображение комплектующего (base64 или URL)
  stock         Int                   @default(0)
  isActive      Boolean               @default(true)
  sortOrder     Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  catalogItem   ComponentCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@map("product_components")
}

model Order {
  id                           String             @id @default(cuid())
  userId                       String
  createdByManagerId           String? // Менеджер оформил заказ для покупателя
  customerEmail                String? // Email получателя (дублирует user.email для поиска)
  customerPhone                String? // Телефон покупателя (для заказов менеджера)
  customerFirstName            String? // Имя покупателя (для заказов менеджера)
  customerMiddleName           String? // Отчество покупателя (для заказов менеджера)
  customerLastName             String? // Фамилия покупателя (для заказов менеджера)
  processedByManagerId         String? // Менеджер, который обработал заказ
  sentToEmailAt                DateTime? // Когда заказ отправлен на email покупателя
  orderViewToken               String?            @unique // Подписанный токен для просмотра по ссылке из письма
  status                       OrderStatus        @default(PENDING)
  total                        Decimal            @db.Decimal(10, 2)
  subtotal                     Decimal            @db.Decimal(10, 2)
  tax                          Decimal            @db.Decimal(10, 2)
  shippingAddressId            String? // Опционально для заказов «на проверке» (до согласования)
  paymentStatus                PaymentStatus      @default(PENDING)
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt
  adminNotes                   String?
  cancelReason                 String?
  cancelledAt                  DateTime?
  customerNotes                String?
  deliveredAt                  DateTime?
  discount                     Decimal            @default(0) @db.Decimal(10, 2)
  orderNumber                  String             @unique
  refundAmount                 Decimal?           @db.Decimal(10, 2)
  refundReason                 String?
  refundedAt                   DateTime?
  shippedAt                    DateTime?
  shippingCost                 Decimal            @db.Decimal(10, 2)
  carryCost                    Decimal?           @db.Decimal(10, 2) // Стоимость грузчиков (оплата по месту и т.п.)
  moversCount                  Int? // Количество грузчиков (указывает админ)
  plannedDeliveryDate          DateTime?          @db.Date // Планируемая дата доставки (указывает админ)
  shippingMethodId             String?
  trackingNumber               String?
  returnedForCorrectionAt      DateTime? // Когда менеджер отправил заказ на доработку покупателю
  returnedForCorrectionComment String?            @db.Text // Комментарий при отправке на доработку
  approvedAt                   DateTime? // Когда заказ переведён в «Проверен»; действие 60 мин
  adminEditedAt                DateTime? // Когда админ вносил изменения (пометка «Отредактировано!» у покупателя)
  submittedForReviewAt         DateTime? // Дата и время приёма заказа на проверку (из корзины)
  deliveryType                 String? // TO_ENTRANCE | TO_APARTMENT — до подъезда или подъём в квартиру
  deliveryFloor                Int? // Этаж (при подъёме в квартиру)
  deliveryHasElevator          Boolean? // Есть лифт (при подъёме в квартиру)
  preferredDeliveryTime        String?            @db.Text // Когда покупателю удобно принять заказ
  items                        OrderItem[]
  orderServiceItems            OrderServiceItem[]
  shippingAddress              Address?           @relation(fields: [shippingAddressId], references: [id])
  shippingMethod               ShippingMethod?    @relation(fields: [shippingMethodId], references: [id])
  user                         User               @relation(fields: [userId], references: [id])
  createdByManager             User?              @relation("OrdersCreatedByManager", fields: [createdByManagerId], references: [id])
  processedByManager           User?              @relation("OrdersProcessedByManager", fields: [processedByManagerId], references: [id])
  payments                     Payment[]
  orderEvents                  OrderEvent[]
  deletedAt                    DateTime?          @map("deleted_at")

  @@index([deletedAt])
  @@map("orders")
}

/// События истории заказа (действия покупателя и менеджера) для блока «История заказа».
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  type      String // created, submitted_for_review, approved, returned_for_correction, cancelled, shipped, delivered, refunded, delivery_edited, customer_edited, item_comment_edited, sent_to_email, add_to_review, add_to_approved
  actor     String // customer | manager
  userId    String? // ID пользователя (менеджера или покупателя), если известен
  user      User?    @relation("OrderEventActor", fields: [userId], references: [id])

  @@index([orderId])
  @@map("order_events")
}

model OrderItem {
  id                    String            @id @default(cuid())
  orderId               String
  /// Обнуляется при удалении товара из каталога (позиция заказа и цена остаются в истории)
  productId             String?
  /// Комплектующее (наличник, добор и т.д.) — отдельно от полотна
  componentId           String?
  cardVariantId         String? // Вариант из «схожих товаров в карточке» (для истории)
  quantity              Float
  price                 Decimal           @db.Decimal(10, 2)
  size                  String?
  openingSide           String?
  /// Снимок наименования комплектующей для истории заказа
  componentLabel        String?
  managerComment        String?           @db.Text // Комментарий менеджера по пункту (для доработки покупателем)
  replacedFromProductId String? // Если менеджер заменил товар — ID исходного товара (для пометки покупателю)
  replacementNote       String?           @db.Text // Пометка о замене для покупателя
  createdAt             DateTime          @default(now())
  order                 Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product               Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  component             ProductComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)
  replacedFromProduct   Product?          @relation("OrderItemReplacedFrom", fields: [replacedFromProductId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

/// Позиция услуг в заказе (Order). Услуги из корзины добавляются в тот же Order, что и товары.
model OrderServiceItem {
  id                   String             @id @default(cuid())
  orderId              String
  serviceCatalogItemId String
  name                 String // Название вида работ (денормализация)
  categoryName         String // Название категории (денормализация)
  roomName             String? // Название помещения (если расчёт делали по помещениям)
  unit                 String // Ед. изм.
  quantity             Decimal            @db.Decimal(12, 2)
  price                Decimal            @db.Decimal(12, 2)
  amount               Decimal            @db.Decimal(12, 2)
  createdAt            DateTime           @default(now())
  order                Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceCatalogItem   ServiceCatalogItem @relation(fields: [serviceCatalogItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([serviceCatalogItemId])
  @@map("order_service_items")
}

model Address {
  id         String      @id @default(cuid())
  userId     String
  type       AddressType @default(SHIPPING)
  firstName  String
  lastName   String
  phone      String
  street     String
  city       String
  region     String?
  postalCode String
  country    String      @default("RU")
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@map("addresses")
}

model CartItem {
  id            String              @id @default(cuid())
  userId        String
  productId     String?
  componentId   String?
  cardVariantId String? // Вариант из «схожих товаров в карточке»
  quantity      Float // Float для поддержки половинок
  size          String?
  openingSide   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  product       Product?            @relation(fields: [productId], references: [id], onDelete: Cascade)
  component     ProductComponent?   @relation(fields: [componentId], references: [id], onDelete: Cascade)
  cardVariant   ProductCardVariant? @relation(fields: [cardVariantId], references: [id], onDelete: SetNull)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, productId])
  @@index([userId, componentId])
  @@map("cart_items")
}

/// Элемент корзины — выбранные услуги из категории каталога услуг.
/// 1 CartServiceItem = 1 категория; счётчик корзины +1 за каждую категорию.
model CartServiceItem {
  id                       String                 @id @default(cuid())
  userId                   String
  serviceCatalogCategoryId String
  items                    Json // [{ itemId: string, quantity: number }]
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  user                     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category                 ServiceCatalogCategory @relation(fields: [serviceCatalogCategoryId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceCatalogCategoryId])
  @@index([userId])
  @@map("cart_service_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model CompareItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("compare_items")
}

model Review {
  id           String    @id @default(cuid())
  productId    String
  userId       String?
  userName     String
  userEmail    String? // Для гостевых отзывов
  rating       Int       @db.SmallInt
  comment      String?   @db.Text
  adminReply   String?   @db.Text // Ответ администратора
  adminReplyAt DateTime? // Когда написан ответ
  isApproved   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model AdminDashboardBlock {
  id                      String                    @id @default("main")
  catalogActivityVisible  Boolean                   @default(false)
  trainingDynamicsVisible Boolean                   @default(true)
  calendarVisible         Boolean                   @default(false)
  dateToolbarVisible      Boolean                   @default(true)
  sectionOrder            Json?
  updatedAt               DateTime                  @updatedAt
  quickLinks              AdminDashboardQuickLink[]

  @@map("admin_dashboard_block")
}

model AdminDashboardQuickLink {
  id        String              @id @default(cuid())
  blockId   String              @default("main")
  label     String
  href      String
  isEnabled Boolean             @default(true)
  sortOrder Int                 @default(0)
  updatedAt DateTime            @updatedAt
  block     AdminDashboardBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([blockId, sortOrder])
  @@map("admin_dashboard_quick_links")
}

model UserCabinetBlock {
  id                       String   @id @default("main")
  showProfileSection       Boolean  @default(true) // Личные данные
  showOrdersSection        Boolean  @default(true) // Мои заказы
  showNotificationsSection Boolean  @default(true) // Уведомления
  showNotificationHistory  Boolean  @default(true) // История уведомлений (только чтение)
  showPasswordSection      Boolean  @default(true) // Смена пароля
  showQuickLinks           Boolean  @default(true) // Быстрые ссылки
  privacyPolicyUrl         String? // PDF единой политики (сайт + квизы)
  privacyPolicyTitle       String?
  privacyPolicyContent     String?  @db.Text
  consentText              String?
  consentLinkText          String?
  updatedAt                DateTime @updatedAt

  @@map("user_cabinet_block")
}

model ReviewsBlock {
  id                String   @id @default("main")
  enabled           Boolean  @default(true) // Включить отзывы и оценки
  showOnCards       Boolean  @default(true) // Показывать рейтинг на карточках товаров
  requirePurchase   Boolean  @default(false) // Только покупатели могут оставлять отзывы
  allowGuestReviews Boolean  @default(true) // Разрешить гостям оставлять отзывы
  requireModeration Boolean  @default(true) // Требовать модерацию перед публикацией
  updatedAt         DateTime @updatedAt

  @@map("reviews_block")
}

model CatalogBlock {
